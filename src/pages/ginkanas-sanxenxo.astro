---
import Layout from '../layouts/Layout.astro';
import FaqSection from '../components/FaqSection.astro';
import Prose from '../components/Prose.astro';

const title = 'Ginkanas en Sanxenxo: despedidas de verano y grupos';
const description = 'Ginkanas en Sanxenxo para despedidas de soltera y grupos. La capital del verano en Galicia. Playa, fiesta y diversión. Desde 25€/persona.';

const zonas = [
  {
    name: 'Playa de Silgar',
    description: 'La playa más famosa de Galicia. Arena fina, paseo marítimo y ambiente. Perfecta para ginkanas playeras en verano.'
  },
  {
    name: 'Puerto deportivo',
    description: 'Yates, terrazas y vistas. Zona más tranquila y elegante para ginkanas de empresa o grupos que buscan algo diferente.'
  },
  {
    name: 'Casco urbano',
    description: 'Calles peatonales llenas de tiendas, bares y restaurantes. El epicentro del ambiente sanxenxino.'
  },
  {
    name: 'Playas de alrededor',
    description: 'Areas, Montalvo, A Lanzada... Si queréis más intimidad, hay playas brutales a pocos minutos.'
  }
];

const porque = [
  { icon: '', titulo: 'Capital del verano', texto: 'De junio a septiembre, Sanxenxo es el sitio. Ambiente garantizado.' },
  { icon: '', titulo: 'Playas top', texto: 'Silgar, Areas, Montalvo... Las mejores playas de Galicia a tu alcance.' },
  { icon: '', titulo: 'Fiesta asegurada', texto: 'Bares, discotecas, terrazas. La noche en Sanxenxo no decepciona.' },
  { icon: '', titulo: 'Marisco brutal', texto: 'Estás en las Rías Baixas. El marisco aquí es otro nivel.' }
];

const schema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "Ginkanas en Sanxenxo",
  "provider": { "@type": "LocalBusiness", "name": "Ginkanas.es", "telephone": "+34678288284" },
  "areaServed": { "@type": "City", "name": "Sanxenxo" },
  "description": description,
  "offers": { "@type": "Offer", "price": "25", "priceCurrency": "EUR" }
};
const ampliado = [
  {
    "h": "Cómo se juega una ginkana en Sanxenxo",
    "p": [
      "Sanxenxo es una villa turística sin casco histórico monumental, así que el punto de encuentro suele ser una calle céntrica o el paseo marítimo; se confirma al reservar. Tras el briefing de 10-15 minutos, el juego de unas dos horas recorre el casco urbano y el paseo junto a la playa de Silgar.",
      "El puerto deportivo aporta un escenario más tranquilo para grupos de empresa, y las playas cercanas (Areas, Montalvo, A Lanzada) sirven para pruebas más abiertas. En verano, el ambiente de calles y terrazas ayuda mucho a las pruebas de interacción."
    ]
  },
  {
    "h": "Cuándo y para quién funciona mejor",
    "ul": [
      "<strong>Verano (junio a septiembre):</strong> máxima animación; es la época de las despedidas.",
      "<strong>Primavera y otoño:</strong> menos gente, más tranquilidad; mejor para empresas y grupos que prefieren jugar sin aglomeraciones.",
      "<strong>Despedida clásica:</strong> <a href=\"/experiencias/ginkana-loca/\">Ginkana Loca</a> por el paseo, tardeo en terraza y noche.",
      "<strong>Grupos grandes:</strong> <a href=\"/experiencias/ginkana-supervivientes/\">Supervivientes</a> en zonas amplias de playa o paseo."
    ],
    "after": [
      "Sanxenxo es muy estacional: fuera de temporada hay menos ambiente, pero también menos gente. Cuéntanos la fecha y te decimos qué esperar."
    ]
  },
  {"h": "Team building para empresas en Sanxenxo", "p": ["Sanxenxo es uno de los destinos preferidos para jornadas de empresa de primavera y verano: playa, puerto deportivo y hoteles con espacio para grupos. La playa de Silgar y las playas de alrededor son perfectas para juegos de equipo al aire libre.", "Para empresas proponemos, entre otras opciones:"], "ul": ["<strong>Juegos de equipo en la playa</strong>: relevos, tiro de cuerda, retos de equilibrio y batalla de agua.", "<strong>Olimpiada de empresa</strong> con varias estaciones y ranking común.", "<strong>Ginkana por el casco urbano y el puerto</strong>.", "<strong>Jornada de aventura o salida en barco</strong>, organizada con proveedores de la zona."], "after": ["Ver todas las <a href=\"/ginkanas-empresas/\">actividades de team building para empresas</a>."]},
  {"h": "Ejemplo de jornada de empresa en Sanxenxo", "ol": ["<strong>Mañana</strong> · Juegos de equipo en la playa con ranking.", "<strong>Mediodía</strong> · Comida en grupo.", "<strong>Tarde</strong> · Ginkana corta por el puerto o actividad náutica.", "<strong>Cierre</strong> · Entrega de premios al atardecer."]}
];

const faqs = [
  {
    "q": "¿Dónde quedamos en Sanxenxo?",
    "a": "En una calle céntrica del casco urbano o en el paseo marítimo de Silgar. Se confirma al reservar."
  },
  {
    "q": "¿Se puede hacer una ginkana en la playa?",
    "a": "Sí, con pruebas adaptadas al espacio abierto. Se plantea sobre todo en verano y se decide con el grupo."
  },
  {
    "q": "¿Cuándo es mejor época para una despedida?",
    "a": "De junio a septiembre hay más ambiente. Fuera de temporada, más tranquilidad. Depende de lo que busquéis."
  },
  {
    "q": "¿Cuánto cuesta una ginkana en Sanxenxo?",
    "a": "Desde 25 € por persona en despedidas, cumpleaños y grupos. Para empresas, presupuesto a medida."
  },
  {
    "q": "¿Qué pasa si llueve en Sanxenxo?",
    "a": "Con lluvia fuerte se pospone sin coste. Con lluvia fina decide el grupo."
  },
  {"q": "¿Organizáis team building para empresas en Sanxenxo?", "a": "Sí. Juegos de equipo en la playa, ginkanas y jornadas a medida para grupos de 6 a 200 personas, sobre todo de primavera a otoño."},
  {"q": "¿Qué pasa si hace mal tiempo en Sanxenxo?", "a": "Con lluvia fuerte se pospone sin coste o se pasa a una actividad de interior, como un escape room móvil en el hotel."}
];
---

<Layout title={title} description={description} schema={schema} faqs={faqs}>
  
  <section class="hero-city">
    <div class="container">
      <div class="hero-split">
        <div class="hero-content">
      <span class="hero-badge">Costa y playa de las Rías Baixas</span>
      <h1>Ginkanas en <span class="text-gradient">Sanxenxo</span></h1>
      <p class="hero-text">Playas, paseo marítimo y espacios abiertos amplios: Sanxenxo es ideal para juegos de equipo al aire libre, jornadas de empresa y encuentros de grupo en temporada.</p>
      <div class="hero-meta">
        <span>De 6 a 200 personas</span>
        <span>2 horas</span>
        <span>Empresas y grupos</span>
      </div>
      <a href="https://wa.me/34678288284?text=Hola!%20Quiero%20info%20sobre%20ginkanas%20en%20Sanxenxo" class="btn btn-whatsapp btn-lg">Pedir propuesta</a>
        </div>
        <img src="/images/fotos/ciudad-sanxenxo.webp" width="800" height="600" alt="Playa de Silgar en Sanxenxo" class="hero-photo" fetchpriority="high" decoding="async">
      </div>
    </div>
  </section>
  
  <section class="section">
    <div class="container">
      <h2 class="section-heading">¿Dónde jugamos en Sanxenxo?</h2>
      <div class="zones-grid">
        {zonas.map((z) => (
          <div class="zone-card">
            <h3>{z.name}</h3>
            <p>{z.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
  
  <section class="section section-alt">
    <div class="container">
      <h2 class="section-heading">¿Por qué Sanxenxo para tu ginkana?</h2>
      <div class="why-grid">
        {porque.map((p) => (
          <div class="why-card">
            <span class="why-icon">{p.icon}</span>
            <h4>{p.titulo}</h4>
            <p>{p.texto}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
  
  <section class="section">
    <div class="container">
      <h2 class="section-heading">Te recomendamos según tu plan</h2>
      <div class="reco-grid">
        <div class="reco-card">
          <h3>Despedida de soltera</h3>
          <p>Ginkana Loca por el paseo de Silgar, tardeo en terraza y luego fiesta hasta el amanecer. El plan clásico.</p>
          <a href="/ginkanas-despedidas/">Ver ginkanas despedidas →</a>
        </div>
        <div class="reco-card">
          <h3>Empresa</h3>
          <p>Puerto deportivo o playas menos masificadas. Team building con vistas al mar y mariscada para cerrar.</p>
          <a href="/ginkanas-empresas/">Ver ginkanas empresas →</a>
        </div>
        <div class="reco-card">
          <h3>Grupo de amigas</h3>
          <p>Ginkana por la mañana, playa al mediodía, cena de marisco y fiesta. Fin de semana redondo.</p>
          <a href="/ginkanas-adultos/">Ver ginkanas adultos →</a>
        </div>
      </div>
    </div>
  </section>
  
  <section class="section aviso-temporada">
    <div class="container text-center">
      <h2>Ojo con la temporada</h2>
      <p>Sanxenxo es muy estacional. De junio a septiembre está a tope. Fuera de temporada hay menos ambiente pero también menos gente. Para despedidas, el verano es imbatible. Para empresas, primavera u otoño pueden ser mejor opción.</p>
    </div>
  </section>
  
  <Prose sections={ampliado} />

  <FaqSection faqs={faqs} />

  <section class="section cta-section">
    <div class="container text-center">
      <h2>¿Organizando algo en Sanxenxo?</h2>
      <p>Cuéntanos las fechas y el plan, y te decimos cómo montarlo.</p>
      <a href="https://wa.me/34678288284" class="btn btn-whatsapp btn-lg">WhatsApp: 678 288 284</a>
    </div>
  </section>
  
</Layout>

<style>
  .hero-city { background: linear-gradient(135deg, #E0F7FA 0%, #fff 100%); padding: var(--space-3xl) 0; }
  .hero-badge { display: inline-block; background: rgba(0,150,136,0.1); color: #00796B; padding: var(--space-sm) var(--space-md); border-radius: var(--radius-full); font-size: 0.875rem; font-weight: 600; margin-bottom: var(--space-lg); }
  .text-gradient { color: var(--color-primary); }
  .hero-text { font-size: 1.0625rem; color: var(--color-text-light); margin: var(--space-lg) 0; max-width: 600px; }
  .hero-meta { display: flex; flex-wrap: wrap; gap: var(--space-lg); margin-bottom: var(--space-xl); font-weight: 500; }
  .section-heading { text-align: center; margin-bottom: var(--space-2xl); }
  .zones-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: var(--space-xl); }
  .zone-card { background: var(--color-bg-alt); padding: var(--space-xl); border-radius: var(--radius-lg); }
  .zone-card h3 { color: #00796B; margin-bottom: var(--space-sm); }
  .zone-card p { color: var(--color-text-light); margin: 0; }
  .why-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: var(--space-xl); }
  .why-card { text-align: center; padding: var(--space-lg); }
  .why-icon { font-size: 2.5rem; display: block; margin-bottom: var(--space-md); }
  .why-card h4 { margin-bottom: var(--space-sm); }
  .why-card p { color: var(--color-text-light); font-size: 0.9375rem; margin: 0; }
  .reco-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-xl); }
  .reco-card { background: var(--color-bg-alt); padding: var(--space-xl); border-radius: var(--radius-lg); }
  .reco-card h3 { margin-bottom: var(--space-md); }
  .reco-card p { color: var(--color-text-light); margin-bottom: var(--space-md); }
  .reco-card a { color: var(--color-primary); font-weight: 600; }
  .aviso-temporada { background: #FFF3E0; }
  .aviso-temporada h2 { color: #E65100; margin-bottom: var(--space-md); }
  .aviso-temporada p { color: var(--color-text); max-width: 700px; margin: 0 auto; }
  .cta-section { background: linear-gradient(135deg, #00796B, #4DB6AC); color: white; }
  .cta-section h2 { color: white; margin-bottom: var(--space-md); }
  .cta-section p { opacity: 0.9; font-size: 1.0625rem; margin-bottom: var(--space-xl); }
  @media (max-width: 1024px) { .zones-grid, .reco-grid { grid-template-columns: 1fr; } .why-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 640px) { .why-grid { grid-template-columns: 1fr; } }
</style>
