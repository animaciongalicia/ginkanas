---
import Layout from '../layouts/Layout.astro';
import FaqSection from '../components/FaqSection.astro';
import Prose from '../components/Prose.astro';

const title = 'Ginkanas en Lugo: despedidas, grupos y empresas';
const description = 'Ginkanas en Lugo para despedidas, empresas y grupos. Muralla romana Patrimonio de la Humanidad, tapas gratis y ambiente auténtico. Desde 25€/persona.';

const zonas = [
  {
    name: 'Muralla romana (UNESCO)',
    description: 'La única muralla romana completa del mundo. 2 km caminables por encima. Escenario único e irrepetible para cualquier ginkana.'
  },
  {
    name: 'Casco histórico',
    description: 'Dentro de la muralla. Catedral, Praza Maior, calles empedradas. Compacto y perfecto para ginkanas de misterio.'
  },
  {
    name: 'Zona de tapas',
    description: 'En Lugo las tapas son GRATIS con cada consumición. La Rúa Nova y alrededores son el paraíso del tapeo. Obligatorio post-ginkana.'
  },
  {
    name: 'Parque Rosalía de Castro',
    description: 'El pulmón verde de Lugo. Amplio, con zonas arboladas. Perfecto para ginkanas con pruebas físicas o grupos grandes.'
  }
];

const porque = [
  { icon: '', titulo: 'Muralla única', texto: 'La única muralla romana completa del mundo. Patrimonio UNESCO. Escenario irrepetible.' },
  { icon: '', titulo: 'Tapas gratis', texto: 'En Lugo, con cada bebida te ponen tapa. Gratis. El tapeo aquí es legendario.' },
  { icon: '', titulo: 'Muy económica', texto: 'Lugo es probablemente la ciudad más barata de Galicia. El presupuesto da para más.' },
  { icon: '', titulo: 'Gastronomía top', texto: 'Carne de vacuno gallego, pulpo, quesos. La materia prima es de 10.' }
];

const schema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "Ginkanas en Lugo",
  "provider": { "@type": "LocalBusiness", "name": "Ginkanas.es", "telephone": "+34678288284" },
  "areaServed": { "@type": "City", "name": "Lugo" },
  "description": description,
  "offers": { "@type": "Offer", "price": "25", "priceCurrency": "EUR" }
};
const ampliado = [
  {
    "h": "Cómo se juega una ginkana en Lugo",
    "p": [
      "El punto de encuentro suele ser la <strong>Praza Maior</strong>, donde está el Ayuntamiento, o una calle céntrica dentro de la muralla; se confirma al reservar. Tras el briefing de 10-15 minutos, la ginkana de unas dos horas se desarrolla en el casco histórico, muy compacto: todo está a pocos minutos a pie.",
      "La muralla romana, Patrimonio de la Humanidad, se puede caminar en unos 2 km y es un escenario único para misterio y leyendas. La zona de la Rúa da Raíña y la Rúa Nova es la de las tapas, ideal para cerrar. Para pruebas físicas se usa el Parque Rosalía de Castro."
    ]
  },
  {
    "h": "Qué esperar de una ginkana en Lugo",
    "ul": [
      "<strong>Escenario:</strong> la muralla y el casco histórico dan un ambiente especial para <a href=\"/experiencias/ginkana-cluedo/\">Cluedo</a>, <a href=\"/experiencias/ginkana-lendas/\">Lendas</a> y <a href=\"/experiencias/ginkana-escuela-magica/\">Escuela Mágica</a>.",
      "<strong>Plan de después:</strong> en Lugo las tapas acompañan cada consumición, así que cerrar la ginkana tapeando es casi obligado.",
      "<strong>Presupuesto:</strong> Lugo es una de las ciudades más económicas de Galicia para comer y tapear."
    ],
    "after": [
      "Si sois un grupo grande, decidimos con vosotros si conviene dividir el juego entre la muralla y el parque."
    ]
  },
  {"h": "Team building para empresas en Lugo", "p": ["Lugo ofrece algo que ninguna otra ciudad tiene: una muralla romana completa, Patrimonio de la Humanidad, que convierte el casco histórico en un tablero de juego perfecto. El Parque Rosalía de Castro aporta espacio verde para juegos de equipo.", "Para empresas proponemos, entre otras opciones:"], "ul": ["<strong>Ginkana dentro de la muralla</strong>, con pruebas y un caso que resolver.", "<strong>Ruta de leyendas</strong> con pruebas por equipos.", "<strong>Juegos de equipo en el Parque Rosalía de Castro</strong>.", "<strong>Escape room</strong> en las salas de la ciudad o móvil en vuestras instalaciones."], "after": ["Ver todas las <a href=\"/ginkanas-empresas/\">actividades de team building para empresas</a>."]},
  {"h": "Por qué Lugo funciona para equipos", "p": ["El recinto amurallado es compacto y está lleno de rincones, así que una ginkana de unas 2 horas recorre la ciudad sin desplazamientos largos. Además, la zona de tapas está a pocos pasos, lo que facilita cerrar la jornada todos juntos."]}
];

const faqs = [
  {
    "q": "¿Dónde quedamos en Lugo?",
    "a": "Normalmente en la Praza Maior, donde está el Ayuntamiento, o en una calle céntrica dentro de la muralla. Se confirma al reservar."
  },
  {
    "q": "¿Se puede jugar sobre la muralla?",
    "a": "El recorrido incluye la muralla cuando el tipo de ginkana lo permite. Lo definimos al preparar la propuesta."
  },
  {
    "q": "¿Qué ginkana recomendáis para Lugo?",
    "a": "Cluedo, Lendas o Escuela Mágica aprovechan al máximo el casco histórico y la muralla."
  },
  {
    "q": "¿Cuánto cuesta una ginkana en Lugo?",
    "a": "Desde 25 € por persona en despedidas, cumpleaños y grupos. Para empresas, presupuesto a medida."
  },
  {
    "q": "¿Qué pasa si llueve en Lugo?",
    "a": "Con lluvia fuerte se pospone sin coste. Con lluvia fina decide el grupo."
  },
  {"q": "¿Organizáis team building para empresas en Lugo?", "a": "Sí. Ginkanas, juegos de equipo, escape room y jornadas a medida para grupos de 6 a 200 personas."},
  {"q": "¿Se puede jugar sobre la muralla?", "a": "El recorrido se diseña por el casco histórico y su entorno, respetando las normas de uso del monumento; lo concretamos al preparar la actividad."}
];
---

<Layout title={title} description={description} schema={schema} faqs={faqs}>
  
  <section class="hero-city">
    <div class="container">
      <div class="hero-split">
        <div class="hero-content">
      <span class="hero-badge">Ciudad de la muralla romana</span>
      <h1>Ginkanas en <span class="text-gradient">Lugo</span></h1>
      <p class="hero-text">El recinto amurallado y su casco histórico son un escenario excepcional para ginkanas de misterio y juegos de equipo de empresa y de grupo.</p>
      <div class="hero-meta">
        <span>De 6 a 200 personas</span>
        <span>2 horas</span>
        <span>Empresas y grupos</span>
      </div>
      <a href="https://wa.me/34678288284?text=Hola!%20Quiero%20info%20sobre%20ginkanas%20en%20Lugo" class="btn btn-whatsapp btn-lg">Pedir propuesta</a>
        </div>
        <img src="/images/fotos/ciudad-lugo.webp" width="800" height="600" alt="Muralla romana y casco histórico de Lugo" class="hero-photo" fetchpriority="high" decoding="async">
      </div>
    </div>
  </section>
  
  <section class="section">
    <div class="container">
      <h2 class="section-heading">¿Dónde jugamos en Lugo?</h2>
      <div class="zones-grid">
        {zonas.map((z) => (
          <div class="zone-card">
            <h3>{z.name}</h3>
            <p>{z.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
  
  <section class="section section-alt">
    <div class="container">
      <h2 class="section-heading">¿Por qué Lugo para tu ginkana?</h2>
      <div class="why-grid">
        {porque.map((p) => (
          <div class="why-card">
            <span class="why-icon">{p.icon}</span>
            <h4>{p.titulo}</h4>
            <p>{p.texto}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
  
  <section class="section">
    <div class="container">
      <h2 class="section-heading">Te recomendamos según tu plan</h2>
      <div class="reco-grid">
        <div class="reco-card">
          <h3>Despedida</h3>
          <p>Ginkana por la muralla y casco histórico. Después, ruta de tapas gratis que puede durar horas. Presupuesto imbatible.</p>
          <a href="/ginkanas-despedidas/">Ver ginkanas despedidas →</a>
        </div>
        <div class="reco-card">
          <h3>Empresa</h3>
          <p>Parque Rosalía para grupos grandes. La muralla como telón de fondo. Cena de empresa con carne gallega.</p>
          <a href="/ginkanas-empresas/">Ver ginkanas empresas →</a>
        </div>
        <div class="reco-card">
          <h3>Cumpleaños</h3>
          <p>Ginkana Templarios por la muralla. Misterio medieval, acertijos históricos. Tapeo épico para cerrar.</p>
          <a href="/ginkanas-adultos/">Ver ginkanas adultos →</a>
        </div>
      </div>
    </div>
  </section>
  
  <section class="section tapas-tip">
    <div class="container text-center">
      <h2>El secreto de Lugo: tapas gratis</h2>
      <p>En Lugo, con cada bebida que pides te ponen una tapa. Gratis. No es broma. Una caña son 1.50€ y viene con pincho de tortilla, empanada, pulpo... Podéis hacer la ginkana y después cenar de tapas gastando casi nada. Es el plan más económico de toda Galicia.</p>
    </div>
  </section>
  
  <Prose sections={ampliado} />

  <FaqSection faqs={faqs} />

  <section class="section cta-section">
    <div class="container text-center">
      <h2>¿Organizando algo en Lugo?</h2>
      <p>Cuéntanos qué celebráis y os ayudamos a montar el plan completo.</p>
      <a href="https://wa.me/34678288284" class="btn btn-whatsapp btn-lg">WhatsApp: 678 288 284</a>
    </div>
  </section>
  
</Layout>

<style>
  .hero-city { background: linear-gradient(135deg, #E8EAF6 0%, #fff 100%); padding: var(--space-3xl) 0; }
  .hero-badge { display: inline-block; background: rgba(48,63,159,0.1); color: #303F9F; padding: var(--space-sm) var(--space-md); border-radius: var(--radius-full); font-size: 0.875rem; font-weight: 600; margin-bottom: var(--space-lg); }
  .text-gradient { color: var(--color-primary); }
  .hero-text { font-size: 1.0625rem; color: var(--color-text-light); margin: var(--space-lg) 0; max-width: 600px; }
  .hero-meta { display: flex; flex-wrap: wrap; gap: var(--space-lg); margin-bottom: var(--space-xl); font-weight: 500; }
  .section-heading { text-align: center; margin-bottom: var(--space-2xl); }
  .zones-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: var(--space-xl); }
  .zone-card { background: var(--color-bg-alt); padding: var(--space-xl); border-radius: var(--radius-lg); }
  .zone-card h3 { color: #303F9F; margin-bottom: var(--space-sm); }
  .zone-card p { color: var(--color-text-light); margin: 0; }
  .why-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: var(--space-xl); }
  .why-card { text-align: center; padding: var(--space-lg); }
  .why-icon { font-size: 2.5rem; display: block; margin-bottom: var(--space-md); }
  .why-card h4 { margin-bottom: var(--space-sm); }
  .why-card p { color: var(--color-text-light); font-size: 0.9375rem; margin: 0; }
  .reco-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-xl); }
  .reco-card { background: var(--color-bg-alt); padding: var(--space-xl); border-radius: var(--radius-lg); }
  .reco-card h3 { margin-bottom: var(--space-md); }
  .reco-card p { color: var(--color-text-light); margin-bottom: var(--space-md); }
  .reco-card a { color: var(--color-primary); font-weight: 600; }
  .tapas-tip { background: #FFF8E1; }
  .tapas-tip h2 { color: #F57C00; margin-bottom: var(--space-md); }
  .tapas-tip p { color: var(--color-text); max-width: 700px; margin: 0 auto; }
  .cta-section { background: linear-gradient(135deg, #303F9F, #5C6BC0); color: white; }
  .cta-section h2 { color: white; margin-bottom: var(--space-md); }
  .cta-section p { opacity: 0.9; font-size: 1.0625rem; margin-bottom: var(--space-xl); }
  @media (max-width: 1024px) { .zones-grid, .reco-grid { grid-template-columns: 1fr; } .why-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 640px) { .why-grid { grid-template-columns: 1fr; } }
</style>
