---
import Layout from '../layouts/Layout.astro';
import FaqSection from '../components/FaqSection.astro';
import Prose from '../components/Prose.astro';

const title = 'Ginkanas en Santiago de Compostela para grupos';
const description = 'Ginkanas en Santiago de Compostela para despedidas, empresas y grupos. Casco histórico Patrimonio de la Humanidad, ambiente universitario. Desde 25€/persona.';

const zonas = [
  {
    name: 'Zona Vieja (Patrimonio UNESCO)',
    description: 'El casco histórico más impresionante de Galicia. La Catedral, Praza do Obradoiro, rúas medievales. Escenario único para ginkanas de misterio y leyendas.'
  },
  {
    name: 'Alameda y Campus',
    description: 'El pulmón verde de Santiago. Perfecto para ginkanas con pruebas físicas o grupos grandes que necesitan espacio.'
  },
  {
    name: 'Zona de vinos (Franco, Raíña)',
    description: 'Las calles más animadas de Santiago. Bares de vinos, pulperías, ambiente. Ideal si después de la ginkana queréis tapear.'
  },
  {
    name: 'San Martiño Pinario',
    description: 'El monasterio más grande de Galicia después de El Escorial. Ambiente misterioso perfecto para escape rooms urbanos.'
  }
];

const porque = [
  { icon: '', titulo: 'Ciudad Patrimonio', texto: 'El casco histórico más bonito de España. Cada calle es un decorado.' },
  { icon: '', titulo: 'Ambiente universitario', texto: 'Ciudad joven, con vida todo el año. No depende del verano.' },
  { icon: '', titulo: 'Rutas de vinos épicas', texto: 'Franco, Raíña, Caldeirería... Después de la ginkana, el plan sigue.' },
  { icon: '', titulo: 'Aeropuerto propio', texto: 'Lavacolla a 15 minutos. Grupos de fuera llegan fácil.' }
];

const schema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "Ginkanas en Santiago de Compostela",
  "provider": { "@type": "LocalBusiness", "name": "Ginkanas.es", "telephone": "+34678288284" },
  "areaServed": { "@type": "City", "name": "Santiago de Compostela" },
  "description": description,
  "offers": { "@type": "Offer", "price": "25", "priceCurrency": "EUR" }
};
const ampliado = [
  {
    "h": "Cómo se juega una ginkana en Santiago",
    "p": [
      "El punto de encuentro habitual es la <strong>Praza do Obradoiro</strong>, frente a la Catedral y junto al Pazo de Raxoi, sede del Ayuntamiento, o una calle céntrica de la Zona Vieja; se confirma al reservar. Después del briefing de 10-15 minutos, el juego de unas dos horas recorre las rúas del casco histórico.",
      "La Zona Vieja es Patrimonio de la Humanidad y ofrece el ambiente ideal para misterio y leyendas, con calles empedradas y plazas como Quintana o Praterías. Para pruebas más físicas se utiliza la zona de la Alameda, y la ginkana suele terminar en las calles de vinos y tapas, como Franco o Raíña."
    ]
  },
  {
    "h": "Qué ginkana elegir según el plan",
    "ul": [
      "<strong>Cumpleaños o quedada:</strong> <a href=\"/experiencias/ginkana-lendas/\">Ginkana Lendas</a> entre la Catedral y San Martiño Pinario.",
      "<strong>Despedida:</strong> <a href=\"/experiencias/ginkana-loca/\">Ginkana Loca</a> por la Zona Vieja y final en la zona de vinos.",
      "<strong>Fans de Harry Potter:</strong> <a href=\"/experiencias/ginkana-escuela-magica/\">Escuela Mágica</a>: las calles empedradas son un decorado natural."
    ],
    "after": [
      "Santiago es una de las ciudades más lluviosas de Galicia. Si llueve fuerte se pospone sin coste; con lluvia fina se juega, que es lo habitual aquí."
    ]
  },
  {"h": "Team building para empresas en Santiago", "p": ["Santiago es una ciudad muy visitada por equipos de fuera de Galicia: congresos, convenciones y reuniones de empresa. Su casco histórico, Patrimonio de la Humanidad, convierte cualquier ginkana en una forma de conocer la ciudad, y la Alameda y el entorno del Campus ofrecen espacio para juegos de equipo.", "Para empresas proponemos, entre otras opciones:"], "ul": ["<strong>Ginkana de misterio por la Zona Vieja</strong>, ideal para grupos con visitantes.", "<strong>Ruta de leyendas</strong> con pruebas, como la <a href=\"/experiencias/ginkana-lendas/\">ginkana Lendas</a>.", "<strong>Juegos de equipo en la Alameda</strong> para grupos grandes.", "<strong>Escape room</strong> en las salas de la ciudad o móvil en el hotel de la convención."], "after": ["Ver todas las <a href=\"/ginkanas-empresas/\">actividades de team building para empresas</a>."]},
  {"h": "Actividad para congresos y convenciones", "p": ["Para grupos que están en Santiago por un congreso o una reunión de varios días, una ginkana de unas 2 horas por la Zona Vieja es una forma de cerrar la jornada, conocer la ciudad y mezclar equipos de distintas sedes. Se adapta a la agenda del evento y al número de asistentes."]}
];

const faqs = [
  {
    "q": "¿Dónde quedamos en Santiago?",
    "a": "Habitualmente en la Praza do Obradoiro o en una calle céntrica de la Zona Vieja. Se confirma al reservar."
  },
  {
    "q": "¿Se puede hacer la ginkana con peregrinos y turistas alrededor?",
    "a": "Sí. Forma parte del ambiente de la Zona Vieja y las pruebas de interacción y las leyendas lo aprovechan."
  },
  {
    "q": "¿Qué ginkana es mejor para un grupo de fuera de Galicia?",
    "a": "La Ginkana Lendas, porque combina juego con historias locales y da a conocer la ciudad de otra forma."
  },
  {
    "q": "¿Cuánto cuesta una ginkana en Santiago?",
    "a": "Desde 25 € por persona en despedidas, cumpleaños y grupos. Para empresas, presupuesto a medida."
  },
  {
    "q": "¿Y si llueve en Santiago?",
    "a": "Con lluvia fuerte se pospone sin coste. Con lluvia fina decide el grupo; en Santiago es lo normal y no quita ambiente."
  },
  {"q": "¿Organizáis actividades para congresos en Santiago?", "a": "Sí. Ginkanas y juegos de equipo de unas 2 horas para asistentes a congresos, convenciones y reuniones, adaptados a la agenda del evento."},
  {"q": "¿Se puede hacer team building en Santiago con grupos grandes?", "a": "Sí, de 6 a 200 personas, con varios equipos en paralelo por la Zona Vieja o con juegos de equipo en espacios abiertos como la Alameda."}
];
---

<Layout title={title} description={description} schema={schema} faqs={faqs}>
  
  <section class="hero-city">
    <div class="container">
      <div class="hero-split">
        <div class="hero-content">
      <span class="hero-badge">Ciudad Patrimonio de la Humanidad</span>
      <h1>Ginkanas en <span class="text-gradient">Santiago</span></h1>
      <p class="hero-text">Un casco histórico único como escenario de juego: calles medievales, plazas y leyendas para ginkanas de empresa y de grupo, con pruebas y un monitor que guía la actividad.</p>
      <div class="hero-meta">
        <span>De 6 a 200 personas</span>
        <span>2 horas</span>
        <span>Empresas y grupos</span>
      </div>
      <a href="https://wa.me/34678288284?text=Hola!%20Quiero%20info%20sobre%20ginkanas%20en%20Santiago" class="btn btn-whatsapp btn-lg">Pedir propuesta</a>
        </div>
        <img src="/images/fotos/ciudad-santiago.webp" width="800" height="600" alt="Catedral de Santiago de Compostela" class="hero-photo" fetchpriority="high" decoding="async">
      </div>
    </div>
  </section>
  
  <section class="section">
    <div class="container">
      <h2 class="section-heading">¿Dónde jugamos en Santiago?</h2>
      <div class="zones-grid">
        {zonas.map((z) => (
          <div class="zone-card">
            <h3>{z.name}</h3>
            <p>{z.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
  
  <section class="section section-alt">
    <div class="container">
      <h2 class="section-heading">¿Por qué Santiago para tu ginkana?</h2>
      <div class="why-grid">
        {porque.map((p) => (
          <div class="why-card">
            <span class="why-icon">{p.icon}</span>
            <h4>{p.titulo}</h4>
            <p>{p.texto}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
  
  <section class="section">
    <div class="container">
      <h2 class="section-heading">Te recomendamos según tu plan</h2>
      <div class="reco-grid">
        <div class="reco-card">
          <h3>Despedida</h3>
          <p>Ginkana Loca por la zona vieja, pulpo en el Mercado y ruta de vinos por Franco. Día completo.</p>
          <a href="/ginkanas-despedidas/">Ver ginkanas despedidas →</a>
        </div>
        <div class="reco-card">
          <h3>Empresa</h3>
          <p>Alameda o campus para grupos grandes. Después, cena de empresa en cualquier restaurante del centro.</p>
          <a href="/ginkanas-empresas/">Ver ginkanas empresas →</a>
        </div>
        <div class="reco-card">
          <h3>Cumpleaños</h3>
          <p>Ginkana Lendas entre la Catedral y San Martiño. Misterio, leyendas y vinos para cerrar.</p>
          <a href="/ginkanas-adultos/">Ver ginkanas adultos →</a>
        </div>
      </div>
    </div>
  </section>
  
  <Prose sections={ampliado} />

  <FaqSection faqs={faqs} />

  <section class="section cta-section">
    <div class="container text-center">
      <h2>¿Organizando algo en Santiago?</h2>
      <p>Cuéntanos qué celebráis y os ayudamos a elegir la mejor opción.</p>
      <a href="https://wa.me/34678288284" class="btn btn-whatsapp btn-lg">WhatsApp: 678 288 284</a>
    </div>
  </section>
  
</Layout>

<style>
  .hero-city { background: linear-gradient(135deg, #FDF6E3 0%, #fff 100%); padding: var(--space-3xl) 0; }
  .hero-badge { display: inline-block; background: rgba(139,90,43,0.1); color: #8B5A2B; padding: var(--space-sm) var(--space-md); border-radius: var(--radius-full); font-size: 0.875rem; font-weight: 600; margin-bottom: var(--space-lg); }
  .text-gradient { color: var(--color-primary); }
  .hero-text { font-size: 1.0625rem; color: var(--color-text-light); margin: var(--space-lg) 0; max-width: 600px; }
  .hero-meta { display: flex; flex-wrap: wrap; gap: var(--space-lg); margin-bottom: var(--space-xl); font-weight: 500; }
  .section-heading { text-align: center; margin-bottom: var(--space-2xl); }
  .zones-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: var(--space-xl); }
  .zone-card { background: var(--color-bg-alt); padding: var(--space-xl); border-radius: var(--radius-lg); }
  .zone-card h3 { color: #8B5A2B; margin-bottom: var(--space-sm); }
  .zone-card p { color: var(--color-text-light); margin: 0; }
  .why-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: var(--space-xl); }
  .why-card { text-align: center; padding: var(--space-lg); }
  .why-icon { font-size: 2.5rem; display: block; margin-bottom: var(--space-md); }
  .why-card h4 { margin-bottom: var(--space-sm); }
  .why-card p { color: var(--color-text-light); font-size: 0.9375rem; margin: 0; }
  .reco-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-xl); }
  .reco-card { background: var(--color-bg-alt); padding: var(--space-xl); border-radius: var(--radius-lg); }
  .reco-card h3 { margin-bottom: var(--space-md); }
  .reco-card p { color: var(--color-text-light); margin-bottom: var(--space-md); }
  .reco-card a { color: var(--color-primary); font-weight: 600; }
  .cta-section { background: linear-gradient(135deg, #8B5A2B, #D4A574); color: white; }
  .cta-section h2 { color: white; margin-bottom: var(--space-md); }
  .cta-section p { opacity: 0.9; font-size: 1.0625rem; margin-bottom: var(--space-xl); }
  @media (max-width: 1024px) { .zones-grid, .reco-grid { grid-template-columns: 1fr; } .why-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 640px) { .why-grid { grid-template-columns: 1fr; } }
</style>
