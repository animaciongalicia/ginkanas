---
import Layout from '../../layouts/Layout.astro';
import { getPosts, TEMAS, formatDate, isoDate } from '../../lib/blog';

const title = 'Blog y novedades | Ideas y Consejos para Ginkanas y Eventos';
const description = 'Guías y novedades sobre ginkanas para despedidas, cumpleaños, grupos y empresas en Galicia. Consejos prácticos, planes originales y todo lo que necesitas saber.';

const posts = await getPosts();

// Filtros de la lista (solo en esta página, sin URLs propias para no competir con las páginas principales)
const filtros = [
  { id: 'todo', label: 'Todo' },
  { id: 'despedidas', label: 'Despedidas' },
  { id: 'cumpleanos', label: 'Cumpleaños y grupos' },
  { id: 'empresas', label: 'Empresas' },
  { id: 'novedad', label: 'Novedades' },
];
---

<Layout title={title} description={description}>
  
  <section class="hero-blog">
    <div class="container">
      <h1>Blog y novedades</h1>
      <p class="hero-text">Ideas, consejos y todo lo que necesitas para organizar algo memorable.</p>
      <p class="hero-rss"><a href="/rss.xml">Suscribirse por RSS</a></p>
    </div>
  </section>
  
  <section class="section">
    <div class="container">
      <div class="blog-filters" id="blog-filters" role="group" aria-label="Filtrar artículos" hidden>
        {filtros.map((f) => (
          <button type="button" class="chip" data-filtro={f.id} aria-pressed={f.id === 'todo' ? 'true' : 'false'}>{f.label}</button>
        ))}
      </div>

      <div class="posts-grid" id="posts-grid">
        {posts.map((post) => (
          <article class="post-card" data-tema={post.data.tema} data-tipo={post.data.tipo} style={`--post-color: ${TEMAS[post.data.tema].accent}`}>
            <span class="post-category">{post.data.etiqueta ?? (post.data.tipo === 'novedad' ? 'Novedad' : TEMAS[post.data.tema].label)}</span>
            <h2><a href={`/blog/${post.slug}/`}>{post.data.titulo}</a></h2>
            <p>{post.data.resumen ?? post.data.descripcion}</p>
            <div class="post-meta">
              <time datetime={isoDate(post.data.fecha)}>{formatDate(post.data.fecha)}</time>
              <a href={`/blog/${post.slug}/`} class="read-more">Leer más →</a>
            </div>
          </article>
        ))}
      </div>
      <p class="no-results" id="no-results" hidden>Todavía no hay artículos en esta selección.</p>
    </div>
  </section>
  
  <section class="section section-alt">
    <div class="container cta-box">
      <div class="cta-content">
        <h2>¿Tienes algo que organizar?</h2>
        <p>Deja de leer y cuéntanos qué necesitas. Te ayudamos a montarlo.</p>
        <a href="https://wa.me/34678288284" class="btn btn-whatsapp btn-lg">WhatsApp: 678 288 284</a>
      </div>
    </div>
  </section>
  
</Layout>

<script>
  const bar = document.getElementById('blog-filters');
  const cards = Array.from(document.querySelectorAll<HTMLElement>('.post-card'));
  const none = document.getElementById('no-results');
  if (bar) {
    bar.hidden = false;
    bar.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('button[data-filtro]');
      if (!btn) return;
      const f = btn.dataset.filtro;
      bar.querySelectorAll('button').forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
      let visibles = 0;
      cards.forEach((c) => {
        const ok = f === 'todo' || (f === 'novedad' ? c.dataset.tipo === 'novedad' : c.dataset.tema === f);
        c.hidden = !ok;
        if (ok) visibles++;
      });
      if (none) none.hidden = visibles > 0;
    });
  }
</script>

<style>
  .hero-blog {
    background: var(--color-bg-alt);
    padding: var(--space-3xl) 0 var(--space-2xl);
    text-align: center;
  }
  
  .hero-text {
    font-size: 1.25rem;
    color: var(--color-text-light);
    margin-top: var(--space-md);
  }
  
  .hero-rss { margin: var(--space-sm) 0 0; font-size: 0.875rem; }
  .blog-filters { display: flex; flex-wrap: wrap; gap: var(--space-sm); justify-content: center; margin-bottom: var(--space-xl); }
  .blog-filters[hidden], .post-card[hidden], .no-results[hidden] { display: none; }
  .chip { border: 1px solid var(--color-border); background: var(--color-bg); color: var(--color-text); padding: var(--space-sm) var(--space-lg); border-radius: var(--radius-full); font: inherit; font-weight: 500; cursor: pointer; }
  .chip[aria-pressed="true"] { background: var(--color-secondary); border-color: var(--color-secondary); color: #fff; }
  .no-results { text-align: center; color: var(--color-text-light); margin-top: var(--space-xl); }

  .posts-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-xl);
  }
  
  .post-card {
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-xl);
    transition: all var(--transition-normal);
    display: flex;
    flex-direction: column;
  }
  
  .post-card:hover {
    box-shadow: var(--shadow-md);
    transform: translateY(-4px);
    border-color: var(--post-color);
  }
  
  .post-category {
    display: inline-block;
    background: var(--post-color);
    color: white;
    padding: var(--space-xs) var(--space-md);
    border-radius: var(--radius-full);
    font-size: 0.75rem;
    font-weight: 600;
    margin-bottom: var(--space-md);
    align-self: flex-start;
  }
  
  .post-card h2 {
    font-size: 1.25rem;
    margin-bottom: var(--space-md);
  }
  
  .post-card h2 a {
    color: var(--color-text);
    text-decoration: none;
  }
  
  .post-card h2 a:hover {
    color: var(--post-color);
  }
  
  .post-card p {
    color: var(--color-text-light);
    margin-bottom: var(--space-lg);
    flex-grow: 1;
  }
  
  .post-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  
  .post-meta time {
    font-size: 0.875rem;
    color: var(--color-text-light);
  }
  
  .read-more {
    color: var(--post-color);
    font-weight: 600;
    font-size: 0.875rem;
  }
  
  .cta-box {
    display: grid;
    grid-template-columns: 1fr;
    text-align: center;
    gap: var(--space-2xl);
    align-items: center;
    background: white;
    padding: var(--space-2xl);
    border-radius: var(--radius-lg);
  }
  
  .cta-content h2 {
    margin-bottom: var(--space-md);
  }
  
  .cta-content p {
    color: var(--color-text-light);
    margin-bottom: var(--space-xl);
  }
  
  @media (max-width: 768px) {
    .posts-grid {
      grid-template-columns: 1fr;
    }
    
    .cta-box {
      grid-template-columns: 1fr;
      text-align: center;
    }
    
  }
</style>
