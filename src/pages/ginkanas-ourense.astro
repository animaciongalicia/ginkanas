---
import Layout from '../layouts/Layout.astro';
import FaqSection from '../components/FaqSection.astro';
import Prose from '../components/Prose.astro';

const title = 'Ginkanas en Ourense: despedidas, grupos y empresas';
const description = 'Ginkanas en Ourense para despedidas, empresas y grupos. Ciudad termal, casco histórico y buen vino. La joya del interior de Galicia. Desde 25€/persona.';

const zonas = [
  {
    name: 'Casco histórico',
    description: 'Catedral, Praza Maior, calles medievales. El centro histórico de Ourense tiene más encanto del que la gente piensa. Perfecto para ginkanas de misterio.'
  },
  {
    name: 'Zona de vinos',
    description: 'Ourense es tierra de vinos. La zona del Vite tiene bares históricos donde el vino se sirve en cunca. Ruta ideal post-ginkana.'
  },
  {
    name: 'Termas urbanas',
    description: 'A Chavasqueira, Outariz, As Burgas... Ourense tiene termas gratuitas en plena ciudad. Ginkana + termas = plan redondo.'
  },
  {
    name: 'Ribeira del Miño',
    description: 'Paseo junto al río con puentes históricos. Zona amplia perfecta para ginkanas con pruebas físicas.'
  }
];

const porque = [
  { icon: '', titulo: 'Termas gratis', texto: 'Pozas termales al aire libre, gratuitas, en plena ciudad. Plan perfecto para después de jugar.' },
  { icon: '', titulo: 'Capital del vino', texto: 'Ribeiro, Valdeorras, Monterrei... El vino aquí es religión.' },
  { icon: '', titulo: 'Precios bajos', texto: 'Ourense es más barata que la costa. Comer y dormir aquí sale muy bien.' },
  { icon: '', titulo: 'Menos masificada', texto: 'Sin turismo de masas. Ambiente local auténtico.' }
];

const schema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "Ginkanas en Ourense",
  "provider": { "@type": "LocalBusiness", "name": "Ginkanas.es", "telephone": "+34678288284" },
  "areaServed": { "@type": "City", "name": "Ourense" },
  "description": description,
  "offers": { "@type": "Offer", "price": "25", "priceCurrency": "EUR" }
};
const ampliado = [
  {
    "h": "Cómo se juega una ginkana en Ourense",
    "p": [
      "El punto de encuentro habitual es la <strong>Praza Maior</strong>, donde está el Ayuntamiento, o una calle céntrica del casco histórico; se confirma al reservar. Tras el briefing de 10-15 minutos, la ginkana de unas dos horas recorre el casco, con la Catedral y sus calles medievales como decorado.",
      "Las Burgas, con sus fuentes termales en pleno casco, son una parada muy característica de la ciudad. Para pruebas más físicas se usa la ribera del Miño, un espacio amplio con puentes históricos."
    ]
  },
  {
    "h": "Qué esperar de una ginkana en Ourense",
    "ul": [
      "<strong>Ambiente local:</strong> menos turismo masivo que en otras ciudades gallegas.",
      "<strong>Plan de después:</strong> ruta de vinos en la zona del Vite, con vino en cunca, o termas al aire libre.",
      "<strong>Ginkana recomendada:</strong> <a href=\"/experiencias/ginkana-cluedo/\">Cluedo</a> o <a href=\"/experiencias/ginkana-lendas/\">Lendas</a> por el casco; Supervivientes en la ribera."
    ],
    "after": [
      "Ourense tiene inviernos fríos y veranos calurosos. En pleno verano, mejor jugar a última hora de la tarde."
    ]
  },
  {"h": "Team building para empresas en Ourense", "p": ["Ourense combina un casco histórico con mucho carácter, la ribera del Miño con espacios abiertos y un patrimonio termal único. Es una buena opción para jornadas de empresa del interior de Galicia y para equipos que quieren algo diferente.", "Para empresas proponemos, entre otras opciones:"], "ul": ["<strong>Ginkana por el casco histórico</strong> con pruebas y pistas por equipos.", "<strong>Juegos de equipo en la ribera del Miño</strong> para grupos grandes.", "<strong>Juego de investigación</strong> por el centro.", "<strong>Escape room</strong> en las salas de la ciudad o móvil en vuestras instalaciones."], "after": ["Ver todas las <a href=\"/ginkanas-empresas/\">actividades de team building para empresas</a>."]},
  {"h": "Ejemplo de jornada de empresa en Ourense", "ol": ["<strong>Mañana</strong> · Ginkana por el casco histórico.", "<strong>Mediodía</strong> · Comida en grupo.", "<strong>Tarde</strong> · Juegos de equipo junto al Miño o tiempo libre en las termas.", "<strong>Cierre</strong> · Ranking y entrega de premios."]}
];

const faqs = [
  {
    "q": "¿Dónde quedamos en Ourense?",
    "a": "Normalmente en la Praza Maior, donde está el Ayuntamiento, o en una calle céntrica del casco. Se confirma al reservar."
  },
  {
    "q": "¿Se puede combinar con las termas?",
    "a": "Sí, es un plan muy habitual: ginkana por el casco y después termas al aire libre en la ciudad."
  },
  {
    "q": "¿Cuál es la mejor época para jugar en Ourense?",
    "a": "Primavera y otoño son las más cómodas. En verano hace mucho calor, así que recomendamos horarios de tarde."
  },
  {
    "q": "¿Cuánto cuesta una ginkana en Ourense?",
    "a": "Desde 25 € por persona en despedidas, cumpleaños y grupos. Para empresas, presupuesto a medida."
  },
  {
    "q": "¿Qué pasa si llueve en Ourense?",
    "a": "Con lluvia fuerte se pospone sin coste. Con lluvia fina decide el grupo."
  },
  {"q": "¿Organizáis team building para empresas en Ourense?", "a": "Sí. Ginkanas, juegos de equipo, escape room y jornadas a medida para grupos de 6 a 200 personas."},
  {"q": "¿Se puede combinar la actividad con las termas?", "a": "Sí. Es una forma muy habitual de cerrar la jornada; lo planificamos al preparar la propuesta."}
];
---

<Layout title={title} description={description} schema={schema} faqs={faqs}>
  
  <section class="hero-city">
    <div class="container">
      <div class="hero-split">
        <div class="hero-content">
      <span class="hero-badge">Ciudad termal junto al Miño</span>
      <h1>Ginkanas en <span class="text-gradient">Ourense</span></h1>
      <p class="hero-text">Casco histórico, puentes sobre el Miño y espacios abiertos: Ourense ofrece un escenario original para ginkanas de empresa, juegos de equipo y encuentros de grupo.</p>
      <div class="hero-meta">
        <span>De 6 a 200 personas</span>
        <span>2 horas</span>
        <span>Empresas y grupos</span>
      </div>
      <a href="https://wa.me/34678288284?text=Hola!%20Quiero%20info%20sobre%20ginkanas%20en%20Ourense" class="btn btn-whatsapp btn-lg">Pedir propuesta</a>
        </div>
        <img src="/images/fotos/ciudad-ourense.webp" width="800" height="600" alt="Puente sobre el río Miño en Ourense" class="hero-photo" fetchpriority="high" decoding="async">
      </div>
    </div>
  </section>
  
  <section class="section">
    <div class="container">
      <h2 class="section-heading">¿Dónde jugamos en Ourense?</h2>
      <div class="zones-grid">
        {zonas.map((z) => (
          <div class="zone-card">
            <h3>{z.name}</h3>
            <p>{z.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
  
  <section class="section section-alt">
    <div class="container">
      <h2 class="section-heading">¿Por qué Ourense para tu ginkana?</h2>
      <div class="why-grid">
        {porque.map((p) => (
          <div class="why-card">
            <span class="why-icon">{p.icon}</span>
            <h4>{p.titulo}</h4>
            <p>{p.texto}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
  
  <section class="section">
    <div class="container">
      <h2 class="section-heading">Te recomendamos según tu plan</h2>
      <div class="reco-grid">
        <div class="reco-card">
          <h3>Despedida</h3>
          <p>Ginkana por la mañana, termas a mediodía, ruta de vinos por la tarde. Plan diferente y económico.</p>
          <a href="/ginkanas-despedidas/">Ver ginkanas despedidas →</a>
        </div>
        <div class="reco-card">
          <h3>Empresa</h3>
          <p>Ribeira del Miño para grupos grandes. Team building + termas + cena de empresa. Diferente y memorable.</p>
          <a href="/ginkanas-empresas/">Ver ginkanas empresas →</a>
        </div>
        <div class="reco-card">
          <h3>Cumpleaños</h3>
          <p>Ginkana Lendas por el casco histórico. Ourense tiene leyendas potentes. Termas y vinos para cerrar.</p>
          <a href="/ginkanas-adultos/">Ver ginkanas adultos →</a>
        </div>
      </div>
    </div>
  </section>
  
  <section class="section termas-tip">
    <div class="container text-center">
      <h2>Combo ganador: Ginkana + Termas</h2>
      <p>Ourense tiene algo que ninguna otra ciudad gallega ofrece: termas gratuitas al aire libre. Podéis hacer la ginkana y después relajaros en A Chavasqueira o Outariz. Es un plan que siempre triunfa.</p>
    </div>
  </section>
  
  <Prose sections={ampliado} />

  <FaqSection faqs={faqs} />

  <section class="section cta-section">
    <div class="container text-center">
      <h2>¿Organizando algo en Ourense?</h2>
      <p>Cuéntanos qué celebráis y os ayudamos a montar el plan completo.</p>
      <a href="https://wa.me/34678288284" class="btn btn-whatsapp btn-lg">WhatsApp: 678 288 284</a>
    </div>
  </section>
  
</Layout>

<style>
  .hero-city { background: linear-gradient(135deg, #FFEBEE 0%, #fff 100%); padding: var(--space-3xl) 0; }
  .hero-badge { display: inline-block; background: rgba(198,40,40,0.1); color: #C62828; padding: var(--space-sm) var(--space-md); border-radius: var(--radius-full); font-size: 0.875rem; font-weight: 600; margin-bottom: var(--space-lg); }
  .text-gradient { color: var(--color-primary); }
  .hero-text { font-size: 1.0625rem; color: var(--color-text-light); margin: var(--space-lg) 0; max-width: 600px; }
  .hero-meta { display: flex; flex-wrap: wrap; gap: var(--space-lg); margin-bottom: var(--space-xl); font-weight: 500; }
  .section-heading { text-align: center; margin-bottom: var(--space-2xl); }
  .zones-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: var(--space-xl); }
  .zone-card { background: var(--color-bg-alt); padding: var(--space-xl); border-radius: var(--radius-lg); }
  .zone-card h3 { color: #C62828; margin-bottom: var(--space-sm); }
  .zone-card p { color: var(--color-text-light); margin: 0; }
  .why-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: var(--space-xl); }
  .why-card { text-align: center; padding: var(--space-lg); }
  .why-icon { font-size: 2.5rem; display: block; margin-bottom: var(--space-md); }
  .why-card h4 { margin-bottom: var(--space-sm); }
  .why-card p { color: var(--color-text-light); font-size: 0.9375rem; margin: 0; }
  .reco-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-xl); }
  .reco-card { background: var(--color-bg-alt); padding: var(--space-xl); border-radius: var(--radius-lg); }
  .reco-card h3 { margin-bottom: var(--space-md); }
  .reco-card p { color: var(--color-text-light); margin-bottom: var(--space-md); }
  .reco-card a { color: var(--color-primary); font-weight: 600; }
  .termas-tip { background: #E3F2FD; }
  .termas-tip h2 { color: #1565C0; margin-bottom: var(--space-md); }
  .termas-tip p { color: var(--color-text); max-width: 700px; margin: 0 auto; }
  .cta-section { background: linear-gradient(135deg, #C62828, #EF5350); color: white; }
  .cta-section h2 { color: white; margin-bottom: var(--space-md); }
  .cta-section p { opacity: 0.9; font-size: 1.0625rem; margin-bottom: var(--space-xl); }
  @media (max-width: 1024px) { .zones-grid, .reco-grid { grid-template-columns: 1fr; } .why-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 640px) { .why-grid { grid-template-columns: 1fr; } }
</style>
