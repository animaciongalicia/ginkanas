---
import Layout from '../layouts/Layout.astro';
import FaqSection from '../components/FaqSection.astro';
import Prose from '../components/Prose.astro';

const title = 'Ginkanas en Vigo: despedidas, empresas y grupos';
const description = 'Ginkanas en Vigo para despedidas de soltera, team building y grupos. Casco Vello, Berbés, zona de copas. La ciudad con más marcha de Galicia. Desde 25€/persona.';

const zonas = [
  {
    name: 'Casco Vello',
    description: 'El corazón histórico de Vigo. Calles empedradas, plazas con encanto y la Praza da Constitución como punto de partida. Ideal para ginkanas de misterio.'
  },
  {
    name: 'Berbés y Puerto',
    description: 'El barrio marinero con más sabor. Olor a mar, ostras en la calle, el Mercado da Pedra. Perfecto para rutas gastro-ginkana.'
  },
  {
    name: 'Churruca y Arenal',
    description: 'El epicentro de la fiesta viguesa. Si la ginkana es para despedida, acabáis donde empieza la noche.'
  },
  {
    name: 'Samil y playas',
    description: 'Para ginkanas veraniegas. Arena, paseo marítimo y vistas a las Cíes. Ideal para combinar juego y playa.'
  }
];

const porque = [
  { icon: '', titulo: 'La mejor noche de Galicia', texto: 'Churruca, Arenal, Berbés... Hay plan hasta el amanecer.' },
  { icon: '', titulo: 'Gastronomía brutal', texto: 'Ostras a pie de calle, pulpo, marisco. Ginkana + ruta gastro.' },
  { icon: '', titulo: 'Playa en la ciudad', texto: 'Samil a 10 minutos. En verano, ginkana y playa el mismo día.' },
  { icon: '', titulo: 'Bien comunicado', texto: 'AP-9, AVE, aeropuerto. Fácil llegar desde cualquier punto.' }
];

const schema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "Ginkanas en Vigo",
  "provider": { "@type": "LocalBusiness", "name": "Ginkanas.es", "telephone": "+34678288284" },
  "areaServed": { "@type": "City", "name": "Vigo" },
  "description": description,
  "offers": { "@type": "Offer", "price": "25", "priceCurrency": "EUR" }
};
const ampliado = [
  {
    "h": "Cómo se juega una ginkana en Vigo",
    "p": [
      "El punto de encuentro suele ser la <strong>Praza do Rei</strong>, junto al Ayuntamiento, o una calle céntrica como la del Príncipe o la Puerta del Sol; se confirma al reservar. Tras el briefing de 10-15 minutos, la ginkana, de unas dos horas, baja hacia el Casco Vello.",
      "El Casco Vello (Praza da Constitución, Praza da Pedra) es el escenario de las ginkanas de misterio y leyendas. Berbés, con su ambiente marinero, encaja con las pruebas más animadas. Y la zona de Churruca y el Arenal es la del ocio, ideal para cerrar una despedida."
    ]
  },
  {
    "h": "Qué ginkana elegir según el plan",
    "ul": [
      "<strong>Despedida:</strong> <a href=\"/experiencias/ginkana-loca/\">Ginkana Loca</a> por el centro y final en la zona de ocio.",
      "<strong>Cumpleaños:</strong> <a href=\"/experiencias/ginkana-cluedo/\">Ginkana Cluedo</a> por el Casco Vello.",
      "<strong>Empresa o grupo grande:</strong> pruebas de equipo en un espacio amplio como Samil o el entorno del puerto."
    ],
    "after": [
      "Vigo tiene cuestas: el calzado cómodo importa aquí más que en otras ciudades."
    ]
  },
  {"h": "Team building para empresas en Vigo", "p": ["Vigo es la ciudad con más empresas de Galicia y una de las más variadas para una jornada de equipo: el Casco Vello para ginkanas con historia, el Berbés y el puerto para pruebas con ambiente marinero, y la zona de Samil y las playas para juegos al aire libre con grupos grandes.", "Para empresas proponemos, entre otras opciones:"], "ul": ["<strong>Ginkana por el Casco Vello y el Berbés</strong>, con pruebas por equipos y un caso que resolver.", "<strong>Juegos de equipo en Samil</strong>: relevos, tiro de cuerda, retos de equilibrio y ranking común.", "<strong>Escape room</strong> en las salas de la ciudad o móvil en vuestra sede, hotel o finca.", "<strong>Jornada combinada</strong> con actividad de aventura o salida por la ría, organizada con proveedores de la zona."], "after": ["Ver todas las <a href=\"/ginkanas-empresas/\">actividades de team building para empresas</a>."]},
  {"h": "Ejemplo de jornada de empresa en Vigo", "ol": ["<strong>Mañana</strong> · Ginkana por el Casco Vello con equipos mezclados.", "<strong>Mediodía</strong> · Comida en grupo.", "<strong>Tarde</strong> · Juegos de equipo en la zona de playas o escape room si llueve.", "<strong>Cierre</strong> · Ranking final y entrega de premios."]}
];

const faqs = [
  {
    "q": "¿Dónde quedamos en Vigo?",
    "a": "Normalmente en la Praza do Rei, junto al Ayuntamiento, o en una calle céntrica como la del Príncipe. Se confirma al reservar."
  },
  {
    "q": "¿Qué barrios de Vigo se usan?",
    "a": "El Casco Vello para misterio y leyendas, Berbés para pruebas más animadas y la zona de Churruca y el Arenal para cerrar una despedida. Samil se usa para grupos grandes."
  },
  {
    "q": "¿Se puede combinar con comida o marisco?",
    "a": "Sí. El recorrido termina en el centro, cerca de la zona de ostras de Berbés y de los restaurantes del Casco Vello."
  },
  {
    "q": "¿Cuánto cuesta una ginkana en Vigo?",
    "a": "Desde 25 € por persona en despedidas, cumpleaños y grupos. Para empresas, presupuesto a medida."
  },
  {
    "q": "¿Hay que subir muchas cuestas?",
    "a": "Vigo tiene cuestas. Conviene llevar calzado cómodo y, si preferís un recorrido más llano, decídnoslo al reservar."
  },
  {"q": "¿Organizáis team building para empresas en Vigo?", "a": "Sí. Ginkanas, juegos de equipo, escape room y jornadas a medida para grupos de 6 a 200 personas, por la ciudad, en la playa o en vuestras instalaciones."},
  {"q": "¿Se pueden hacer juegos en la playa de Samil?", "a": "Sí, es uno de los espacios que usamos para juegos de equipo al aire libre, sobre todo en primavera y verano."}
];
---

<Layout title={title} description={description} schema={schema} faqs={faqs}>
  
  <section class="hero-city">
    <div class="container">
      <div class="hero-split">
        <div class="hero-content">
      <span class="hero-badge">La mayor ciudad de Galicia</span>
      <h1>Ginkanas en <span class="text-gradient">Vigo</span></h1>
      <p class="hero-text">Casco histórico, puerto y frente marítimo en una sola ciudad. Vigo permite juegos de equipo para empresas en espacios muy distintos y con buenas comunicaciones.</p>
      <div class="hero-meta">
        <span>De 6 a 200 personas</span>
        <span>2 horas</span>
        <span>Empresas y grupos</span>
      </div>
      <a href="https://wa.me/34678288284?text=Hola!%20Quiero%20info%20sobre%20ginkanas%20en%20Vigo" class="btn btn-whatsapp btn-lg">Pedir propuesta</a>
        </div>
        <img src="/images/fotos/ciudad-vigo.webp" width="800" height="600" alt="Vista panorámica de Vigo y su ría" class="hero-photo" fetchpriority="high" decoding="async">
      </div>
    </div>
  </section>
  
  <section class="section">
    <div class="container">
      <h2 class="section-heading">¿Dónde jugamos en Vigo?</h2>
      <div class="zones-grid">
        {zonas.map((z) => (
          <div class="zone-card">
            <h3>{z.name}</h3>
            <p>{z.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
  
  <section class="section section-alt">
    <div class="container">
      <h2 class="section-heading">¿Por qué Vigo para tu ginkana?</h2>
      <div class="why-grid">
        {porque.map((p) => (
          <div class="why-card">
            <span class="why-icon">{p.icon}</span>
            <h4>{p.titulo}</h4>
            <p>{p.texto}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
  
  <section class="section">
    <div class="container">
      <h2 class="section-heading">Te recomendamos según tu plan</h2>
      <div class="reco-grid">
        <div class="reco-card">
          <h3>Despedida</h3>
          <p>Ginkana Loca por el Casco Vello, ostras en Berbés y luego Churruca. Plan redondo.</p>
          <a href="/ginkanas-despedidas/">Ver ginkanas despedidas →</a>
        </div>
        <div class="reco-card">
          <h3>Empresa</h3>
          <p>Samil o zona del puerto para grupos grandes. Espacio, vistas y buen ambiente.</p>
          <a href="/ginkanas-empresas/">Ver ginkanas empresas →</a>
        </div>
        <div class="reco-card">
          <h3>Cumpleaños</h3>
          <p>Ginkana Cluedo por el Casco Vello. Misterio, risas y cañas en Praza da Pedra.</p>
          <a href="/ginkanas-adultos/">Ver ginkanas adultos →</a>
        </div>
      </div>
    </div>
  </section>
  
  <Prose sections={ampliado} />

  <FaqSection faqs={faqs} />

  <section class="section cta-section">
    <div class="container text-center">
      <h2>¿Organizando algo en Vigo?</h2>
      <p>Cuéntanos qué celebráis y os ayudamos a elegir la mejor opción.</p>
      <a href="https://wa.me/34678288284" class="btn btn-whatsapp btn-lg">WhatsApp: 678 288 284</a>
    </div>
  </section>
  
</Layout>

<style>
  .hero-city { background: var(--color-bg-alt); padding: var(--space-2xl) 0; }
  .hero-badge { display: inline-block; background: rgba(0,78,137,0.1); color: var(--color-secondary); padding: var(--space-sm) var(--space-md); border-radius: var(--radius-full); font-size: 0.875rem; font-weight: 600; margin-bottom: var(--space-lg); }
  .text-gradient { color: var(--color-primary); }
  .hero-text { font-size: 1.0625rem; color: var(--color-text-light); margin: var(--space-lg) 0; max-width: 600px; }
  .hero-meta { display: flex; flex-wrap: wrap; gap: var(--space-lg); margin-bottom: var(--space-xl); font-weight: 500; }
  .section-heading { text-align: center; margin-bottom: var(--space-2xl); }
  .zones-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: var(--space-xl); }
  .zone-card { background: var(--color-bg-alt); padding: var(--space-xl); border-radius: var(--radius-lg); }
  .zone-card h3 { color: var(--color-secondary); margin-bottom: var(--space-sm); }
  .zone-card p { color: var(--color-text-light); margin: 0; }
  .why-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: var(--space-xl); }
  .why-card { text-align: center; padding: var(--space-lg); }
  .why-icon { font-size: 2.5rem; display: block; margin-bottom: var(--space-md); }
  .why-card h4 { margin-bottom: var(--space-sm); }
  .why-card p { color: var(--color-text-light); font-size: 0.9375rem; margin: 0; }
  .reco-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-xl); }
  .reco-card { background: var(--color-bg-alt); padding: var(--space-xl); border-radius: var(--radius-lg); }
  .reco-card h3 { margin-bottom: var(--space-md); }
  .reco-card p { color: var(--color-text-light); margin-bottom: var(--space-md); }
  .reco-card a { color: var(--color-primary); font-weight: 600; }
  .cta-section { background: linear-gradient(135deg, var(--color-secondary), #0077CC); color: white; }
  .cta-section h2 { color: white; margin-bottom: var(--space-md); }
  .cta-section p { opacity: 0.9; font-size: 1.0625rem; margin-bottom: var(--space-xl); }
  @media (max-width: 1024px) { .zones-grid, .reco-grid { grid-template-columns: 1fr; } .why-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 640px) { .why-grid { grid-template-columns: 1fr; } }
</style>
