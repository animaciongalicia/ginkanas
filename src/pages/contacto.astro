---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';

const title = 'Contacto | Ginkanas.es';
const description = 'Contacta con Ginkanas.es para reservar tu experiencia en Galicia. WhatsApp, teléfono o formulario. Te respondemos lo antes posible.';
---

<Layout title={title} description={description}>
  
  <section class="hero-inner">
    <div class="container">
      <h1>¿Hablamos?</h1>
      <p class="hero-text">Cuéntanos qué tenéis en mente y os ayudamos a montarlo.</p>
    </div>
  </section>
  
  <section class="section">
    <div class="container">
      <div class="contact-grid">
        
        <div class="contact-options">
          <div class="contact-card whatsapp">
            <div class="contact-icon"><Icon name="chat" size={36} stroke={1.5} /></div>
            <h3>WhatsApp</h3>
            <p>La forma más rápida. Respuesta casi instantánea.</p>
            <a href="https://wa.me/34678288284" class="btn btn-whatsapp" target="_blank" rel="noopener">
              Abrir WhatsApp
            </a>
            <span class="contact-number">678 288 284</span>
          </div>
          
          <div class="contact-card phone">
            <div class="contact-icon"><Icon name="phone" size={36} stroke={1.5} /></div>
            <h3>Teléfono</h3>
            <p>Si prefieres llamar directamente.</p>
            <a href="tel:+34678288284" class="btn btn-secondary">
              Llamar ahora
            </a>
            <span class="contact-number">678 288 284</span>
          </div>
          
          <div class="contact-card hours">
            <div class="contact-icon"><Icon name="clock" size={36} stroke={1.5} /></div>
            <h3>Horario</h3>
            <p>Atendemos todos los días de 9:00 a 21:00. Fuera de horario, déjanos WhatsApp y te respondemos en cuanto podamos.</p>
          </div>
        </div>
        
        <div class="contact-form-wrapper">
          <h2>O déjanos un mensaje</h2>
          <p>Rellena el formulario y te contactamos nosotros.</p>
          
          <form class="contact-form" action="https://formsubmit.co/animaciongalicia@gmail.com" method="POST">
            <!-- FormSubmit: envía cada solicitud como email a animaciongalicia@gmail.com -->
            <input type="hidden" name="_subject" value="Nueva solicitud de ginkana desde ginkanas.es">
            <input type="hidden" name="_template" value="table">
            <input type="hidden" name="_captcha" value="false">
            <input type="hidden" name="_next" value="https://www.ginkanas.es/gracias/">
            <input type="text" name="_honey" class="hp-field" tabindex="-1" autocomplete="off" aria-hidden="true">

            <div class="form-group">
              <label for="name">Nombre *</label>
              <input type="text" id="name" name="name" autocomplete="name" required>
            </div>

            <div class="form-group">
              <label for="email">Email *</label>
              <input type="email" id="email" name="email" autocomplete="email" required>
            </div>

            <div class="form-group">
              <label for="phone">Teléfono</label>
              <input type="tel" id="phone" name="phone" autocomplete="tel">
            </div>

            <div class="form-group">
              <label for="type">¿Qué celebras?</label>
              <select id="type" name="tipo_evento">
                <option value="">Selecciona una opción</option>
                <option value="Despedida de soltera">Despedida de soltera</option>
                <option value="Despedida de soltero">Despedida de soltero</option>
                <option value="Evento de empresa">Evento de empresa</option>
                <option value="Cumpleaños">Cumpleaños</option>
                <option value="Quedada de grupo">Quedada de grupo</option>
                <option value="Otro">Otro</option>
              </select>
            </div>

            <div class="form-group">
              <label for="people">¿Cuántas personas?</label>
              <input type="number" id="people" name="personas" min="1">
            </div>

            <div class="form-group">
              <label for="city">¿En qué ciudad?</label>
              <select id="city" name="ciudad">
                <option value="">Selecciona una ciudad</option>
                <option value="A Coruña">A Coruña</option>
                <option value="Vigo">Vigo</option>
                <option value="Santiago">Santiago</option>
                <option value="Sanxenxo">Sanxenxo</option>
                <option value="Pontevedra">Pontevedra</option>
                <option value="Ourense">Ourense</option>
                <option value="Lugo">Lugo</option>
                <option value="Otra">Otra</option>
              </select>
            </div>

            <div class="form-group full-width">
              <label for="message">Cuéntanos más *</label>
              <textarea id="message" name="mensaje" rows="4" required placeholder="Fecha aproximada, qué tipo de ginkana os interesa, cualquier detalle que nos ayude..."></textarea>
            </div>

            <div class="form-group full-width consent">
              <label class="consent-label">
                <input type="checkbox" name="acepta_privacidad" value="Sí" required>
                <span>He leído y acepto la <a href="/privacidad/" target="_blank" rel="noopener">política de privacidad</a>. Usaréis mis datos solo para responder a esta solicitud. *</span>
              </label>
            </div>

            <button type="submit" class="btn btn-primary btn-lg">Enviar mensaje</button>
          </form>
        </div>
        
      </div>
    </div>
  </section>
  
</Layout>

<style>
  .hero-inner {
    background: var(--color-bg-alt);
    padding: var(--space-3xl) 0 var(--space-2xl);
    text-align: center;
  }
  
  .hero-text {
    font-size: 1.25rem;
    color: var(--color-text-light);
    max-width: 500px;
    margin: var(--space-md) auto 0;
  }
  
  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 1.5fr;
    gap: var(--space-3xl);
  }
  
  .contact-options {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }
  
  .contact-card {
    background: var(--color-bg-alt);
    padding: var(--space-xl);
    border-radius: var(--radius-lg);
    text-align: center;
  }
  
  .contact-icon {
    font-size: 2.5rem;
    margin-bottom: var(--space-md);
  }
  
  .contact-card h3 { margin-bottom: var(--space-sm); }
  .contact-card p { color: var(--color-text-light); margin-bottom: var(--space-lg); }
  
  .contact-number {
    display: block;
    margin-top: var(--space-md);
    font-size: 0.875rem;
    color: var(--color-text-light);
  }
  
  .contact-form-wrapper h2 { margin-bottom: var(--space-sm); }
  .contact-form-wrapper > p { color: var(--color-text-light); margin-bottom: var(--space-xl); }
  
  .contact-form {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-lg);
  }
  
  .form-group {
    display: flex;
    flex-direction: column;
  }
  
  .form-group.full-width {
    grid-column: 1 / -1;
  }
  
  .form-group label {
    font-weight: 500;
    margin-bottom: var(--space-sm);
  }
  
  .form-group input,
  .form-group select,
  .form-group textarea {
    padding: var(--space-md);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    font-family: var(--font-primary);
    font-size: 1rem;
    transition: border-color var(--transition-fast);
  }
  
  .form-group input:focus,
  .form-group select:focus,
  .form-group textarea:focus {
    outline: none;
    border-color: var(--color-primary);
  }
  
  .contact-form button {
    grid-column: 1 / -1;
    justify-self: start;
  }
  
  @media (max-width: 1024px) {
    .contact-grid {
      grid-template-columns: 1fr;
    }
    
    .contact-options {
      flex-direction: row;
      flex-wrap: wrap;
    }
    
    .contact-card {
      flex: 1 1 calc(50% - var(--space-md));
    }
  }
  
  @media (max-width: 640px) {
    .contact-options {
      flex-direction: column;
    }
    
    .contact-card {
      flex: 1 1 100%;
    }
    
    .contact-form {
      grid-template-columns: 1fr;
    }
  }
  .hp-field { position: absolute; left: -9999px; width: 1px; height: 1px; opacity: 0; }
  .consent-label { display: flex; gap: var(--space-sm); align-items: flex-start; font-weight: 400; font-size: 0.9375rem; }
  .consent-label input { margin-top: 0.3rem; width: auto; }
</style>
