---
import Layout from '../layouts/Layout.astro';
import Prose from '../components/Prose.astro';
import Icon from '../components/Icon.astro';

const title = 'Contacto y reservas de ginkanas en Galicia';
const description = 'Contacta con Ginkanas.es para reservar tu experiencia en Galicia. WhatsApp, teléfono o formulario. Te respondemos lo antes posible.';
const ampliado = [
  {
    "h": "Cómo reservar una ginkana en cuatro pasos",
    "ol": [
      "<strong>Contacta.</strong> Por WhatsApp, teléfono o formulario. Cuéntanos cuántos sois, qué celebráis y cuándo queréis hacerlo.",
      "<strong>Elige.</strong> Te recomendamos la ginkana que mejor encaja con el grupo. Si dudas, mira antes la <a href=\"/experiencias/\">comparativa de experiencias</a>.",
      "<strong>Reserva.</strong> Confirmamos fecha, ciudad y punto de encuentro, y se cierra con una pequeña señal.",
      "<strong>Juega.</strong> El día de la ginkana, el monitor os recibe, explica el juego en un briefing de 10-15 minutos y empieza la partida."
    ]
  },
  {
    "h": "Qué necesitamos para proponerte una ginkana",
    "ul": [
      "<strong>Número de personas.</strong> El mínimo habitual es de 6 (la Cluedo y la Supervivientes piden 8; empresas, desde 10).",
      "<strong>Ciudad.</strong> Trabajamos en toda Galicia, sobre todo en A Coruña, Vigo, Santiago, Sanxenxo, Pontevedra, Ourense y Lugo.",
      "<strong>Ocasión.</strong> Despedida, cumpleaños, quedada o evento de empresa: cambia el tono de las pruebas.",
      "<strong>Fecha aproximada.</strong> Con ella confirmamos disponibilidad."
    ],
    "after": [
      "El precio parte de 25 € por persona en despedidas, cumpleaños y grupos, y es a medida para empresas."
    ]
  }
];
---

<Layout title={title} description={description}>
  
  <section class="hero-inner">
    <div class="container">
      <h1>¿Hablamos?</h1>
      <p class="hero-text">Cuéntanos qué tenéis en mente y os ayudamos a montarlo.</p>
    </div>
  </section>
  
  <section class="section">
    <div class="container">
      <div class="contact-grid">
        
        <div class="contact-options">
          <div class="contact-card whatsapp">
            <div class="contact-icon"><Icon name="chat" size={36} stroke={1.5} /></div>
            <h3>WhatsApp</h3>
            <p>La forma más rápida. Respuesta casi instantánea.</p>
            <a href="https://wa.me/34678288284" class="btn btn-whatsapp" target="_blank" rel="noopener">
              Abrir WhatsApp
            </a>
            <span class="contact-number">678 288 284</span>
          </div>
          
          <div class="contact-card phone">
            <div class="contact-icon"><Icon name="phone" size={36} stroke={1.5} /></div>
            <h3>Teléfono</h3>
            <p>Si prefieres llamar directamente.</p>
            <a href="tel:+34678288284" class="btn btn-secondary">
              Llamar ahora
            </a>
            <span class="contact-number">678 288 284</span>
          </div>
          
          <div class="contact-card mail">
            <div class="contact-icon"><Icon name="mail" size={36} stroke={1.5} /></div>
            <h3>Correo</h3>
            <p>Si prefieres escribirnos con calma.</p>
            <a href="mailto:animaciongalicia@gmail.com?subject=Consulta%20sobre%20ginkanas" class="btn btn-secondary">
              Escribir un correo
            </a>
            <span class="contact-number">animaciongalicia@gmail.com</span>
          </div>

          <div class="contact-card hours">
            <div class="contact-icon"><Icon name="clock" size={36} stroke={1.5} /></div>
            <h3>Horario</h3>
            <p>Atendemos todos los días de 9:00 a 21:00. Fuera de horario, déjanos WhatsApp y te respondemos en cuanto podamos.</p>
          </div>
        </div>
        
        <div class="contact-form-wrapper">
          <h2>O escríbenos desde aquí</h2>
          <p>Rellena los datos y elige cómo enviarlos: por WhatsApp o desde tu correo.</p>
          
          <form class="contact-form" id="contact-form" novalidate>
            <div class="form-group">
              <label for="name">Nombre *</label>
              <input type="text" id="name" name="nombre" autocomplete="name" required>
            </div>

            <div class="form-group">
              <label for="email">Tu email (opcional)</label>
              <input type="email" id="email" name="email" autocomplete="email">
            </div>

            <div class="form-group">
              <label for="phone">Tu teléfono (opcional)</label>
              <input type="tel" id="phone" name="telefono" autocomplete="tel">
            </div>

            <div class="form-group">
              <label for="type">¿Qué celebras?</label>
              <select id="type" name="ocasion">
                <option value="">Selecciona una opción</option>
                <option value="Despedida de soltera">Despedida de soltera</option>
                <option value="Despedida de soltero">Despedida de soltero</option>
                <option value="Evento de empresa o team building">Evento de empresa o team building</option>
                <option value="Cumpleaños">Cumpleaños</option>
                <option value="Quedada de grupo">Quedada de grupo</option>
                <option value="Otro">Otro</option>
              </select>
            </div>

            <div class="form-group">
              <label for="people">¿Cuántas personas?</label>
              <input type="number" id="people" name="personas" min="1">
            </div>

            <div class="form-group">
              <label for="city">¿En qué ciudad?</label>
              <select id="city" name="ciudad">
                <option value="">Selecciona una ciudad</option>
                <option value="A Coruña">A Coruña</option>
                <option value="Vigo">Vigo</option>
                <option value="Santiago">Santiago</option>
                <option value="Sanxenxo">Sanxenxo</option>
                <option value="Pontevedra">Pontevedra</option>
                <option value="Ourense">Ourense</option>
                <option value="Lugo">Lugo</option>
                <option value="Otra">Otra</option>
              </select>
            </div>

            <div class="form-group full-width">
              <label for="message">Cuéntanos más *</label>
              <textarea id="message" name="mensaje" rows="4" required placeholder="Fecha aproximada, qué tipo de ginkana os interesa, cualquier detalle que nos ayude..."></textarea>
            </div>

            <div class="form-actions full-width">
              <button type="button" class="btn btn-whatsapp btn-lg" data-send="whatsapp">Enviar por WhatsApp</button>
              <button type="button" class="btn btn-primary btn-lg" data-send="email">Enviar por correo</button>
            </div>

            <p class="form-note full-width">
              Al pulsar, se abre tu WhatsApp o tu programa de correo con el mensaje ya escrito. Lo envías tú desde tu cuenta, así te queda copia de lo que nos has mandado.
              Si prefieres, <a href="tel:+34678288284">llámanos al 678 288 284</a>.
            </p>
          </form>
        </div>
        
      </div>
    </div>
  </section>
  
<Prose sections={ampliado} />

  </Layout>

<script>
  const EMAIL = 'animaciongalicia@gmail.com';
  const WHATSAPP = '34678288284';
  const form = document.getElementById('contact-form') as HTMLFormElement | null;

  function mensaje(): { asunto: string; texto: string } {
    const d = new FormData(form!);
    const v = (k: string) => String(d.get(k) ?? '').trim();
    const lineas = ['Hola, me gustaría información sobre una ginkana.', ''];
    const campos: [string, string][] = [
      ['Nombre', v('nombre')],
      ['Email', v('email')],
      ['Teléfono', v('telefono')],
      ['Ocasión', v('ocasion')],
      ['Personas', v('personas')],
      ['Ciudad', v('ciudad')],
    ];
    campos.forEach(([k, val]) => { if (val) lineas.push(`${k}: ${val}`); });
    lineas.push('', v('mensaje'));
    const asunto = ['Consulta sobre ginkanas', v('ocasion'), v('ciudad')].filter(Boolean).join(' - ');
    return { asunto, texto: lineas.join('\n') };
  }

  form?.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('button[data-send]');
    if (!btn || !form) return;
    if (!form.reportValidity()) return;
    const { asunto, texto } = mensaje();
    if (btn.dataset.send === 'whatsapp') {
      window.open(`https://wa.me/${WHATSAPP}?text=${encodeURIComponent(texto)}`, '_blank', 'noopener');
    } else {
      window.location.href = `mailto:${EMAIL}?subject=${encodeURIComponent(asunto)}&body=${encodeURIComponent(texto.replace(/\n/g, '\r\n'))}`;
    }
  });
</script>

<style>
  .hero-inner {
    background: var(--color-bg-alt);
    padding: var(--space-3xl) 0 var(--space-2xl);
    text-align: center;
  }
  
  .hero-text {
    font-size: 1.25rem;
    color: var(--color-text-light);
    max-width: 500px;
    margin: var(--space-md) auto 0;
  }
  
  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 1.5fr;
    gap: var(--space-3xl);
  }
  
  .contact-options {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }
  
  .contact-card {
    background: var(--color-bg-alt);
    padding: var(--space-xl);
    border-radius: var(--radius-lg);
    text-align: center;
  }
  
  .contact-icon {
    font-size: 2.5rem;
    margin-bottom: var(--space-md);
  }
  
  .contact-card h3 { margin-bottom: var(--space-sm); }
  .contact-card p { color: var(--color-text-light); margin-bottom: var(--space-lg); }
  
  .contact-number {
    display: block;
    margin-top: var(--space-md);
    font-size: 0.875rem;
    color: var(--color-text-light);
  }
  
  .contact-form-wrapper h2 { margin-bottom: var(--space-sm); }
  .contact-form-wrapper > p { color: var(--color-text-light); margin-bottom: var(--space-xl); }
  
  .contact-form {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-lg);
  }
  
  .form-group {
    display: flex;
    flex-direction: column;
  }
  
  .form-group.full-width {
    grid-column: 1 / -1;
  }
  
  .form-group label {
    font-weight: 500;
    margin-bottom: var(--space-sm);
  }
  
  .form-group input,
  .form-group select,
  .form-group textarea {
    padding: var(--space-md);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    font-family: var(--font-primary);
    font-size: 1rem;
    transition: border-color var(--transition-fast);
  }
  
  .form-group input:focus,
  .form-group select:focus,
  .form-group textarea:focus {
    outline: none;
    border-color: var(--color-primary);
  }
  
  
  @media (max-width: 1024px) {
    .contact-grid {
      grid-template-columns: 1fr;
    }
    
    .contact-options {
      flex-direction: row;
      flex-wrap: wrap;
    }
    
    .contact-card {
      flex: 1 1 calc(50% - var(--space-md));
    }
  }
  
  @media (max-width: 640px) {
    .contact-options {
      flex-direction: column;
    }
    
    .contact-card {
      flex: 1 1 100%;
    }
    
    .contact-form {
      grid-template-columns: 1fr;
    }
  }
  .form-actions { grid-column: 1 / -1; display: flex; flex-wrap: wrap; gap: var(--space-md); }
  .form-note { grid-column: 1 / -1; color: var(--color-text-light); font-size: 0.9375rem; margin: 0; }
</style>
