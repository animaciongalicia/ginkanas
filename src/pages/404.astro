---
import Layout from '../layouts/Layout.astro';

const title = 'Página no encontrada';
const description = 'Esta página no existe o ha cambiado de sitio. Vuelve al inicio o mira las ginkanas disponibles.';
---

<Layout title={title} description={description} noindex={true}>
  <section class="section">
    <div class="container notfound">
      <p class="code">404</p>
      <h1>Aquí no hay pista que seguir</h1>
      <p>La página que buscas no existe o ha cambiado de sitio. Prueba con estos enlaces:</p>
      <ul>
        <li><a href="/">Inicio</a></li>
        <li><a href="/experiencias/">Todas las experiencias</a></li>
        <li><a href="/ginkanas-despedidas/">Ginkanas para despedidas</a></li>
        <li><a href="/ginkanas-empresas/">Ginkanas para empresas</a></li>
        <li><a href="/contacto/">Contacto</a></li>
      </ul>
    </div>
  </section>
</Layout>

<style>
  .notfound { text-align: center; max-width: 640px; padding-top: var(--space-2xl); padding-bottom: var(--space-2xl); }
  .code { font-family: var(--font-display); font-size: 4rem; font-weight: 800; color: var(--color-primary); margin: 0; }
  .notfound ul { list-style: none; margin-top: var(--space-lg); display: grid; gap: var(--space-sm); }
</style>
