---
import Layout from '../layouts/Layout.astro';
import FaqSection from '../components/FaqSection.astro';
import Prose from '../components/Prose.astro';

const title = 'Ginkanas en Pontevedra | Despedidas y Grupos';
const description = 'Ginkanas en Pontevedra para despedidas, empresas y grupos. Casco histórico peatonal, ambiente tranquilo y encanto gallego. Desde 25€/persona.';

const zonas = [
  {
    name: 'Casco histórico peatonal',
    description: 'Uno de los cascos antiguos más bonitos de Galicia, 100% peatonal. Plazas con soportales, iglesias románicas y calles empedradas. Perfecto para ginkanas sin prisas.'
  },
  {
    name: 'Praza da Ferrería',
    description: 'El corazón de Pontevedra. Terrazas, ambiente y el punto de encuentro natural. Ideal para empezar o terminar la ginkana.'
  },
  {
    name: 'Zona de A Moureira',
    description: 'El barrio marinero histórico. Ambiente tradicional, casas de pescadores y el río Lérez como telón de fondo.'
  },
  {
    name: 'Illa das Esculturas',
    description: 'Parque con esculturas al aire libre junto al río. Espacio abierto perfecto para pruebas físicas o grupos grandes.'
  }
];

const porque = [
  { icon: '', titulo: '100% peatonal', texto: 'El casco histórico sin coches. Puedes jugar tranquilo por toda la zona vieja.' },
  { icon: '', titulo: 'Patrimonio brutal', texto: 'Románico, gótico, plazas con encanto. Cada esquina es una foto.' },
  { icon: '', titulo: 'Ambiente relajado', texto: 'Menos turismo masivo que Santiago. Más auténtico, más local.' },
  { icon: '', titulo: 'Buen vino y tapeo', texto: 'Zona de Albariños. El tapeo por el centro es obligatorio.' }
];

const schema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "Ginkanas en Pontevedra",
  "provider": { "@type": "LocalBusiness", "name": "Ginkanas.es", "telephone": "+34678288284" },
  "areaServed": { "@type": "City", "name": "Pontevedra" },
  "description": description,
  "offers": { "@type": "Offer", "price": "25", "priceCurrency": "EUR" }
};
const ampliado = [
  {
    "h": "Cómo se juega una ginkana en Pontevedra",
    "p": [
      "El punto de encuentro natural es la <strong>Praza da Ferrería</strong>, en pleno casco histórico, o la plaza del Ayuntamiento; se confirma al reservar. Tras el briefing de 10-15 minutos, la ginkana de unas dos horas recorre el casco antiguo, que es peatonal: se juega sin coches y sin prisas.",
      "El casco histórico, con plazas como la de la Peregrina o la de la Leña, sus soportales y sus iglesias, da mucho juego a misterio y leyendas. Para pruebas más físicas se usa la Illa das Esculturas o el entorno del río Lérez."
    ]
  },
  {
    "h": "Qué ginkana elegir según el plan",
    "ul": [
      "<strong>Cumpleaños o quedada:</strong> <a href=\"/experiencias/ginkana-cluedo/\">Ginkana Cluedo</a> por el casco peatonal.",
      "<strong>Cultura y leyendas:</strong> <a href=\"/experiencias/ginkana-lendas/\">Lendas</a>, con la leyenda del puente del Burgo entre las posibles paradas.",
      "<strong>Despedida tranquila:</strong> Loca o Cluedo, con tapeo y albariño al final."
    ],
    "after": [
      "Pontevedra es de escala pequeña: casi todo queda a pie a pocos minutos, por eso las ginkanas fluyen sin desplazamientos."
    ]
  }
];

const faqs = [
  {
    "q": "¿Dónde quedamos en Pontevedra?",
    "a": "Normalmente en la Praza da Ferrería o en la plaza del Ayuntamiento. Se confirma al reservar."
  },
  {
    "q": "¿Se juega sin coches?",
    "a": "Sí. El casco histórico es peatonal, así que el recorrido es cómodo y seguro."
  },
  {
    "q": "¿Qué ginkana recomendáis para una despedida en Pontevedra?",
    "a": "La Ginkana Loca funciona bien si el grupo quiere animación; para grupos más tranquilos, la Ginkana Cluedo. Ambas terminan cerca de zonas de tapeo."
  },
  {
    "q": "¿Cuánto cuesta una ginkana en Pontevedra?",
    "a": "Desde 25 € por persona en despedidas, cumpleaños y grupos. Para empresas, presupuesto a medida."
  },
  {
    "q": "¿Qué pasa si llueve en Pontevedra?",
    "a": "Con lluvia fuerte se pospone sin coste. Los soportales del casco antiguo ayudan a resguardarse en una lluvia ligera."
  }
];
---

<Layout title={title} description={description} schema={schema} faqs={faqs}>
  
  <section class="hero-city">
    <div class="container">
      <span class="hero-badge">La ciudad peatonal</span>
      <h1>Ginkanas en <span class="text-gradient">Pontevedra</span></h1>
      <p class="hero-text">Casco histórico 100% peatonal, plazas con encanto y ambiente tranquilo. Pontevedra es la joya escondida de las Rías Baixas.</p>
      <div class="hero-meta">
        <span>Desde 25€/persona</span>
        <span>2 horas</span>
        <span>Desde 6 personas</span>
      </div>
      <a href="https://wa.me/34678288284?text=Hola!%20Quiero%20info%20sobre%20ginkanas%20en%20Pontevedra" class="btn btn-whatsapp btn-lg">Reservar en Pontevedra</a>
    </div>
  </section>
  
  <section class="section">
    <div class="container">
      <h2 class="section-heading">¿Dónde jugamos en Pontevedra?</h2>
      <div class="zones-grid">
        {zonas.map((z) => (
          <div class="zone-card">
            <h3>{z.name}</h3>
            <p>{z.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
  
  <section class="section section-alt">
    <div class="container">
      <h2 class="section-heading">¿Por qué Pontevedra para tu ginkana?</h2>
      <div class="why-grid">
        {porque.map((p) => (
          <div class="why-card">
            <span class="why-icon">{p.icon}</span>
            <h4>{p.titulo}</h4>
            <p>{p.texto}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
  
  <section class="section">
    <div class="container">
      <h2 class="section-heading">Te recomendamos según tu plan</h2>
      <div class="reco-grid">
        <div class="reco-card">
          <h3>Despedida</h3>
          <p>Ginkana por el casco histórico, tapeo por las plazas y si queréis fiesta, Sanxenxo está a 20 minutos.</p>
          <a href="/ginkanas-despedidas/">Ver ginkanas despedidas →</a>
        </div>
        <div class="reco-card">
          <h3>Empresa</h3>
          <p>Illa das Esculturas para grupos grandes o casco histórico para algo más íntimo. Cena en cualquier restaurante del centro.</p>
          <a href="/ginkanas-empresas/">Ver ginkanas empresas →</a>
        </div>
        <div class="reco-card">
          <h3>Cumpleaños</h3>
          <p>Ginkana Cluedo o Lendas por la zona vieja. Misterio entre plazas y soportales, vinos para cerrar.</p>
          <a href="/ginkanas-adultos/">Ver ginkanas adultos →</a>
        </div>
      </div>
    </div>
  </section>
  
  <Prose sections={ampliado} />

  <FaqSection faqs={faqs} />

  <section class="section cta-section">
    <div class="container text-center">
      <h2>¿Organizando algo en Pontevedra?</h2>
      <p>Cuéntanos qué celebráis y os ayudamos a elegir la mejor opción.</p>
      <a href="https://wa.me/34678288284" class="btn btn-whatsapp btn-lg">WhatsApp: 678 288 284</a>
    </div>
  </section>
  
</Layout>

<style>
  .hero-city { background: linear-gradient(135deg, #F3E5F5 0%, #fff 100%); padding: var(--space-3xl) 0; }
  .hero-badge { display: inline-block; background: rgba(106,27,154,0.1); color: #6A1B9A; padding: var(--space-sm) var(--space-md); border-radius: var(--radius-full); font-size: 0.875rem; font-weight: 600; margin-bottom: var(--space-lg); }
  .text-gradient { color: var(--color-primary); }
  .hero-text { font-size: 1.25rem; color: var(--color-text-light); margin: var(--space-lg) 0; max-width: 600px; }
  .hero-meta { display: flex; flex-wrap: wrap; gap: var(--space-lg); margin-bottom: var(--space-xl); font-weight: 500; }
  .section-heading { text-align: center; margin-bottom: var(--space-2xl); }
  .zones-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: var(--space-xl); }
  .zone-card { background: var(--color-bg-alt); padding: var(--space-xl); border-radius: var(--radius-lg); }
  .zone-card h3 { color: #6A1B9A; margin-bottom: var(--space-sm); }
  .zone-card p { color: var(--color-text-light); margin: 0; }
  .why-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: var(--space-xl); }
  .why-card { text-align: center; padding: var(--space-lg); }
  .why-icon { font-size: 2.5rem; display: block; margin-bottom: var(--space-md); }
  .why-card h4 { margin-bottom: var(--space-sm); }
  .why-card p { color: var(--color-text-light); font-size: 0.9375rem; margin: 0; }
  .reco-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-xl); }
  .reco-card { background: var(--color-bg-alt); padding: var(--space-xl); border-radius: var(--radius-lg); }
  .reco-card h3 { margin-bottom: var(--space-md); }
  .reco-card p { color: var(--color-text-light); margin-bottom: var(--space-md); }
  .reco-card a { color: var(--color-primary); font-weight: 600; }
  .cta-section { background: linear-gradient(135deg, #6A1B9A, #AB47BC); color: white; }
  .cta-section h2 { color: white; margin-bottom: var(--space-md); }
  .cta-section p { opacity: 0.9; font-size: 1.25rem; margin-bottom: var(--space-xl); }
  @media (max-width: 1024px) { .zones-grid, .reco-grid { grid-template-columns: 1fr; } .why-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 640px) { .why-grid { grid-template-columns: 1fr; } }
</style>
