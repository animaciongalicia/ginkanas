---
import Layout from '../layouts/Layout.astro';
import Prose from '../components/Prose.astro';
import FaqSection from '../components/FaqSection.astro';
import Icon from '../components/Icon.astro';
import { ACTIVIDADES } from '../data/actividades';

const title = 'Team building y juegos para empresas en Galicia';
const description = 'Team building y juegos para empresas en Galicia: ginkanas, retos, construcción en equipo, indoor, outdoor y aventura. De 6 a 200 personas.';

const beneficios = [
  {
    icon: '',
    title: 'Mejora la comunicación',
    text: 'Cuando juegas, las barreras caen. El jefe, el becario y el de contabilidad son iguales en un juego por equipos.'
  },
  {
    icon: '',
    title: 'Potencia la creatividad',
    text: 'Resolver pruebas absurdas activa partes del cerebro que Excel no toca. Y eso se nota después.'
  },
  {
    icon: '',
    title: 'Crea recuerdos compartidos',
    text: 'Las anécdotas del juego aparecerán en cada cena de empresa durante años. Garantizado.'
  },
  {
    icon: '',
    title: 'Rompe la rutina',
    text: 'Un equipo que solo trabaja, se quema. Un equipo que también juega, rinde más.'
  }
];

const galeria = [
  { src: '/images/fotos/galeria-playa.webp', w: 696, h: 464, alt: 'Equipos de empresa en una prueba de equilibrio en la playa' },
  { src: '/images/fotos/galeria-mapa.webp', w: 720, h: 480, alt: 'Equipo consultando un mapa durante una ginkana' },
  { src: '/images/fotos/galeria-investigacion.webp', w: 720, h: 480, alt: 'Grupo investigando pistas en un juego de misterio' },
  { src: '/images/fotos/galeria-cuerda.webp', w: 535, h: 357, alt: 'Equipo tirando de una cuerda en una prueba por equipos' },
];

const ampliado = [
  {
    "h": "Team building para empresas: elige el formato que encaja con tu equipo",
    "p": [
      "Un buen team building no es una dinámica forzada: es una actividad con reglas claras, equipos, retos y un monitor que la dinamiza. Organizamos <strong>jornadas de team building y juegos para empresas en toda Galicia</strong>, de 6 a 200 personas, y las adaptamos al objetivo, al perfil del equipo y al espacio disponible.",
      "Puede ser una <a href=\"/team-building-ginkanas-y-retos/\">ginkana o un juego de retos</a>, un reto de <a href=\"/team-building-construccion/\">construcción en equipo</a>, una <a href=\"/team-building-indoor/\">jornada indoor</a>, actividades <a href=\"/team-building-outdoor/\">outdoor</a>, juegos tipo <a href=\"/team-building-humor-amarillo/\">Humor Amarillo</a> o una jornada de <a href=\"/team-building-aventura/\">aventura</a> con paintball, rafting, karts o barcos. Y se pueden combinar."
    ]
  },
  {
    "h": "Para equipos de todos los tamaños",
    "ul": [
      "<strong>Equipos pequeños (desde 6 personas):</strong> escape room, juego de investigación o un reto de construcción.",
      "<strong>Grupos medianos:</strong> ginkanas y juegos de equipo con varios equipos que compiten entre sí.",
      "<strong>Grupos grandes (hasta 200 personas):</strong> varios juegos en paralelo con rotación, marcador común y entrega de premios. El <a href=\"/escape-room/\">escape room móvil</a> admite hasta 100 personas."
    ]
  },
  {
    "h": "Cómo se prepara una actividad de empresa",
    "p": [
      "Con el número de personas, la ciudad y el objetivo (integrar a un equipo nuevo, celebrar un cierre, mejorar la comunicación), proponemos formato, duración y presupuesto. Una actividad suele durar entre 2 y 4 horas, y se puede ampliar a una jornada completa.",
      "El día de la actividad, el monitor abre con un briefing, divide al grupo en equipos y explica el juego. Tú solo tienes que disfrutar con tu equipo."
    ]
  },
  {
    "h": "¿Buscas una jornada completa, una regata o un evento de más de 200 personas?",
    "p": [
      "Para jornadas de empresa completas, regatas, experiencias gastronómicas o eventos muy grandes, trabajamos con <a href=\"https://www.mileventosgalicia.com\" rel=\"noopener\">Mil Eventos Galicia</a>, nuestra otra web especializada en eventos de empresa."
    ]
  },
  {
    "h": "Qué cambia en un equipo después",
    "p": [
      "No prometemos milagros de una tarde, pero sí algo que se nota al día siguiente: gente que no se hablaba, hablando; compañeros que descubren cómo piensa otro; y una anécdota compartida para arrancar reuniones.",
      "Para pedir presupuesto solo hace falta decirnos cuántas personas sois, en qué ciudad y qué fecha tenéis pensada."
    ]
  }
];

const faqs = [
  {
    "q": "¿Qué actividades de team building ofrecéis?",
    "a": "Ginkanas y juegos de retos, construcción en equipo, jornadas indoor, actividades outdoor, juegos tipo Humor Amarillo y aventura (paintball, rafting, karts, barcos). Se combinan y se adaptan al grupo."
  },
  {
    "q": "¿Para cuántas personas se puede organizar?",
    "a": "Para grupos de 6 a 200 personas. El escape room móvil admite hasta 100 personas repartidas en equipos."
  },
  {
    "q": "¿Cuánto dura una actividad de team building?",
    "a": "Entre 2 y 4 horas, según el formato y el objetivo."
  },
  {
    "q": "¿Dónde se puede hacer?",
    "a": "En toda Galicia: por el centro de la ciudad, en playas y parques, en vuestras instalaciones, un hotel, una finca o un salón de eventos."
  },
  {
    "q": "¿Cuánto cuesta?",
    "a": "El presupuesto es a medida, según el número de personas, la ciudad y el formato. Pídelo por WhatsApp o desde la página de contacto."
  }
];

const schema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "Team building y juegos para empresas en Galicia",
  "provider": {
    "@type": "LocalBusiness",
    "name": "Ginkanas.es"
  },
  "areaServed": "Galicia, Spain",
  "description": description
};
---

<Layout title={title} description={description} schema={schema} faqs={faqs} ogImage="/images/fotos/og-empresas.jpg">
  
  <!-- HERO -->
  <section class="hero-inner">
    <div class="container">
      <div class="hero-split">
      <div class="hero-content">
        <span class="hero-badge">Team building y juegos para empresas</span>
        <h1>Team building y <span class="text-gradient">juegos para empresas</span> en Galicia</h1>
        <p class="hero-text">Ginkanas, retos, construcción en equipo, jornadas indoor, actividades outdoor y aventura. Un monitor guía cada actividad y la adaptamos a tu objetivo, a tu equipo y a tu espacio. De 6 a 200 personas, en toda Galicia.</p>
        <div class="hero-meta">
          <span class="meta-item">En toda Galicia</span>
          <span class="meta-item">De 6 a 200 personas</span>
          <span class="meta-item">2-4 horas de actividad</span>
        </div>
        <div class="hero-cta">
          <a href="https://wa.me/34678288284?text=Hola!%20Necesito%20info%20sobre%20ginkanas%20para%20empresa" class="btn btn-primary btn-lg" target="_blank" rel="noopener">
            Pedir propuesta
          </a>
        </div>
      </div>
      <img src="/images/fotos/hero-empresas.webp" width="1000" height="833" alt="Equipo de empresa jugando una ginkana en la playa" class="hero-photo" fetchpriority="high" decoding="async">
      </div>
    </div>
  </section>
  
  <!-- BENEFICIOS -->
  <section class="section">
    <div class="container">
      <div class="section-title">
        <h2>¿Por qué un team building con juegos?</h2>
        <p>Porque las cenas de empresa están bien, pero no crean equipo. Esto sí.</p>
      </div>
      
      <div class="benefits-grid">
        {beneficios.map((b) => (
          <div class="benefit-card">
            <h3>{b.title}</h3>
            <p>{b.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
  
  <!-- ACTIVIDADES -->
  <section class="section section-alt" id="actividades">
    <div class="container">
      <div class="section-title">
        <h2>Actividades de team building</h2>
        <p>Seis familias de actividades. Se combinan entre sí para montar la jornada que tu equipo necesita.</p>
      </div>

      <div class="act-grid">
        {ACTIVIDADES.map((a) => (
          <a href={`/team-building-${a.slug}/`} class="act-card">
            <div class="act-media">
              {a.img
                ? <img src={a.img.src} alt={a.img.alt} width={a.img.w} height={a.img.h} loading="lazy" decoding="async">
                : a.mascota
                  ? <img src={`/images/mascota/${a.mascota}.webp`} alt="" width="240" height="280" loading="lazy" decoding="async" class="act-mascot">
                  : <Icon name={a.icono} size={48} stroke={1.2} />}
            </div>
            <div class="act-body">
              <h3>{a.nombre}</h3>
              <p>{a.resumen}</p>
              <span class="act-link">Ver ejemplos →</span>
            </div>
          </a>
        ))}
      </div>
      <p class="act-note">¿Algo que no ves aquí? <a href="/contacto/?tipo=empresa">Cuéntanos qué buscas</a> y diseñamos un juego a medida.</p>
    </div>
  </section>
  
  <!-- GALERÍA -->
  <section class="section">
    <div class="container">
      <div class="section-title">
        <h2>Así se juega</h2>
        <p>Fotos reales de grupos que han jugado con nosotros.</p>
      </div>
      <div class="gallery-grid">
        {galeria.map((g) => (
          <img src={g.src} width={g.w} height={g.h} alt={g.alt} loading="lazy" decoding="async">
        ))}
      </div>
    </div>
  </section>

  <!-- PROCESO -->
  <section class="section">
    <div class="container">
      <div class="section-title">
        <h2>¿Cómo trabajamos con empresas?</h2>
        <p>Sin burocracia. Queremos que sea fácil para ti.</p>
      </div>
      
      <div class="process-timeline">
        <div class="timeline-item">
          <div class="timeline-marker">1</div>
          <div class="timeline-content">
            <h3>Nos cuentas</h3>
            <p>Cuántas personas, qué objetivo buscáis (cohesión, celebración, integración...), fechas posibles y presupuesto orientativo.</p>
          </div>
        </div>
        <div class="timeline-item">
          <div class="timeline-marker">2</div>
          <div class="timeline-content">
            <h3>Proponemos</h3>
            <p>Te mandamos una propuesta personalizada con el formato que mejor encaja, ubicación y precio cerrado.</p>
          </div>
        </div>
        <div class="timeline-item">
          <div class="timeline-marker">3</div>
          <div class="timeline-content">
            <h3>Ajustamos</h3>
            <p>Si quieres cambiar algo, lo adaptamos. Podemos incluir pruebas específicas de vuestra empresa o sector.</p>
          </div>
        </div>
        <div class="timeline-item">
          <div class="timeline-marker">4</div>
          <div class="timeline-content">
            <h3>Ejecutamos</h3>
            <p>El día D nos encargamos de todo. Tú solo tienes que disfrutar con tu equipo.</p>
          </div>
        </div>
      </div>
    </div>
  </section>
  
  <!-- CASOS DE USO -->
  <section class="section section-alt">
    <div class="container">
      <div class="section-title">
        <h2>¿Para qué ocasión?</h2>
        <p>Hay mil excusas para organizar una actividad de empresa. Estas son las más frecuentes.</p>
      </div>
      
      <div class="occasions-grid">
        <div class="occasion">
          <h4>Kick-offs y arranques</h4>
          <p>Empezar el año o un proyecto con energía y buen rollo.</p>
        </div>
        <div class="occasion">
          <h4>Integraciones</h4>
          <p>Cuando se fusionan equipos o llegan muchas incorporaciones.</p>
        </div>
        <div class="occasion">
          <h4>Celebraciones</h4>
          <p>Cerrar un buen trimestre, un aniversario, un logro importante.</p>
        </div>
        <div class="occasion">
          <h4>Cambios de cultura</h4>
          <p>Cuando quieres transmitir que esto es diferente, que aquí se trabaja distinto.</p>
        </div>
        <div class="occasion">
          <h4>Eventos anuales</h4>
          <p>La típica jornada de empresa pero con algo que de verdad mola.</p>
        </div>
        <div class="occasion">
          <h4>Incentivos</h4>
          <p>Premiar al equipo con algo memorable, no con otra cena aburrida.</p>
        </div>
      </div>
    </div>
  </section>
  
  <!-- CTA -->
  <Prose sections={ampliado} />

  <FaqSection faqs={faqs} />

  <section class="section cta-section">
    <div class="container">
      <div class="cta-box">
        <div class="cta-content">
          <h2>¿Hablamos de tu equipo?</h2>
          <p>Cuéntanos qué necesitas y te preparamos una propuesta sin compromiso. Presupuesto cerrado, sin sorpresas.</p>
          <div class="cta-buttons">
            <a href="https://wa.me/34678288284?text=Hola!%20Necesito%20presupuesto%20para%20team%20building" class="btn btn-whatsapp btn-lg" target="_blank" rel="noopener">
              WhatsApp: 678 288 284
            </a>
            <a href="/contacto/" class="btn btn-outline btn-lg">
              Formulario de contacto
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
  
</Layout>

<style>
  .hero-inner {
    background: linear-gradient(135deg, #E8F4FD 0%, var(--color-bg) 100%);
    padding: var(--space-3xl) 0;
  }
  
  .hero-split { display: grid; grid-template-columns: 1.15fr 1fr; gap: var(--space-2xl); align-items: center; }
  .hero-photo { display: block; width: 100%; height: auto; aspect-ratio: 1000 / 833; object-fit: cover; border-radius: var(--radius-lg); box-shadow: var(--shadow-lg); }
  .gallery-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: var(--space-md); }
  .gallery-grid img { width: 100%; height: auto; aspect-ratio: 3 / 2; object-fit: cover; border-radius: var(--radius-md); }
  .format-card { grid-column: span 2; }
  .format-card:nth-child(n+4) { grid-column: span 3; }
  .act-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-lg); }
  .act-card { background: var(--color-bg); border: 1px solid var(--color-border); border-radius: var(--radius-lg); overflow: hidden; display: flex; flex-direction: column; color: var(--color-text); text-decoration: none; transition: box-shadow var(--transition-normal), border-color var(--transition-normal); }
  .act-card:hover { box-shadow: var(--shadow-md); border-color: var(--color-secondary); color: var(--color-text); }
  .act-media { height: 180px; display: flex; align-items: center; justify-content: center; background: var(--color-bg-alt); color: var(--color-secondary); overflow: hidden; }
  .act-media img { width: 100%; height: 100%; object-fit: cover; }
  .act-media img.act-mascot { width: auto; height: 160px; object-fit: contain; }
  .act-body { padding: var(--space-lg); display: flex; flex-direction: column; gap: var(--space-sm); flex-grow: 1; }
  .act-body h3 { margin: 0; }
  .act-body p { color: var(--color-text-light); font-size: 0.9375rem; margin: 0; flex-grow: 1; }
  .act-link { color: var(--color-primary); font-weight: 600; font-size: 0.875rem; }
  .act-note { text-align: center; margin: var(--space-xl) 0 0; color: var(--color-text-light); }
  .format-link { display: inline-block; margin-top: var(--space-md); font-weight: 600; }
  .hero-content {
    max-width: 800px;
  }
  
  .hero-badge {
    display: inline-block;
    background: rgba(0, 78, 137, 0.1);
    color: var(--color-secondary);
    padding: var(--space-sm) var(--space-md);
    border-radius: var(--radius-full);
    font-size: 0.875rem;
    font-weight: 600;
    margin-bottom: var(--space-lg);
  }
  
  .text-gradient { color: var(--color-primary); }
  
  .hero-content h1 { margin-bottom: var(--space-md); }
  .hero-text {
    font-size: 1.0625rem;
    color: var(--color-text-light);
    margin-bottom: var(--space-xl);
  }
  
  .hero-meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-lg);
    margin-bottom: var(--space-xl);
  }
  
  .meta-item {
    font-weight: 500;
    color: var(--color-text);
  }
  
  .benefits-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-xl);
  }
  
  .benefit-card {
    text-align: center;
    padding: var(--space-xl);
  }
  
  .benefit-icon {
    font-size: 1.75rem;
    margin-bottom: var(--space-lg);
  }
  
  .benefit-card h3 {
    margin-bottom: var(--space-md);
    font-size: 1.125rem;
  }
  
  .benefit-card p {
    color: var(--color-text-light);
    font-size: 0.9375rem;
  }
  
  
  .format-card {
    background: var(--color-bg);
    padding: var(--space-xl);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-md);
  }
  
  .format-card h3 {
    color: var(--color-secondary);
    margin-bottom: var(--space-md);
  }
  
  .format-card p {
    color: var(--color-text-light);
    margin-bottom: var(--space-lg);
  }
  
  .format-ideal {
    background: var(--color-bg-alt);
    padding: var(--space-md);
    border-radius: var(--radius-md);
    font-size: 0.875rem;
  }
  
  .process-timeline {
    max-width: 700px;
    margin: 0 auto;
  }
  
  .timeline-item {
    display: flex;
    gap: var(--space-xl);
    padding-bottom: var(--space-xl);
    position: relative;
  }
  
  .timeline-item:not(:last-child)::after {
    content: '';
    position: absolute;
    left: 24px;
    top: 50px;
    bottom: 0;
    width: 2px;
    background: var(--color-border);
  }
  
  .timeline-marker {
    width: 50px;
    height: 50px;
    background: var(--color-secondary);
    color: white;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-display);
    font-weight: 700;
    flex-shrink: 0;
  }
  
  .timeline-content h3 {
    margin-bottom: var(--space-sm);
  }
  
  .timeline-content p {
    color: var(--color-text-light);
  }
  
  .occasions-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-xl);
  }
  
  .occasion {
    background: var(--color-bg);
    padding: var(--space-lg);
    border-radius: var(--radius-md);
  }
  
  .occasion h4 {
    margin-bottom: var(--space-sm);
  }
  
  .occasion p {
    color: var(--color-text-light);
    font-size: 0.9375rem;
    margin: 0;
  }
  
  .cta-section {
    background: var(--color-bg-dark);
  }
  
  .cta-box {
    background: linear-gradient(135deg, var(--color-secondary), #0066B3);
    padding: var(--space-3xl);
    border-radius: var(--radius-lg);
    text-align: center;
  }
  
  .cta-box h2 {
    color: white;
    margin-bottom: var(--space-md);
  }
  
  .cta-box p {
    color: rgba(255,255,255,0.9);
    font-size: 1.125rem;
    margin-bottom: var(--space-xl);
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
  }
  
  .cta-buttons {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: var(--space-md);
  }
  
  .cta-box .btn-outline {
    border-color: white;
    color: white;
  }
  
  .cta-box .btn-outline:hover {
    background: white;
    color: var(--color-secondary);
  }
  
  @media (max-width: 1024px) {
    .hero-split { grid-template-columns: 1fr; }
    .act-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .gallery-grid { grid-template-columns: repeat(2, 1fr); }
    .benefits-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    
    .formats-grid {
      grid-template-columns: 1fr;
    }
    
    .occasions-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  
  @media (max-width: 640px) {
    .benefits-grid {
      grid-template-columns: 1fr;
    }
    
    .occasions-grid {
      grid-template-columns: 1fr;
    }
    
    .timeline-item {
      flex-direction: column;
      gap: var(--space-md);
    }
    
    .timeline-item:not(:last-child)::after {
      display: none;
    }
  }
</style>
