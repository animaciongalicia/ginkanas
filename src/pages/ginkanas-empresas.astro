---
import Layout from '../layouts/Layout.astro';
import Prose from '../components/Prose.astro';
import FaqSection from '../components/FaqSection.astro';

const title = 'Team building y juegos para empresas en Galicia';
const description = 'Team building y juegos a medida para empresas en Galicia: ginkanas, escape room y competiciones para grupos de 6 a 200 personas. Propuesta a medida.';

const beneficios = [
  {
    icon: '',
    title: 'Mejora la comunicación',
    text: 'Cuando juegas, las barreras caen. El jefe, el becario y el de contabilidad son iguales en un juego por equipos.'
  },
  {
    icon: '',
    title: 'Potencia la creatividad',
    text: 'Resolver pruebas absurdas activa partes del cerebro que Excel no toca. Y eso se nota después.'
  },
  {
    icon: '',
    title: 'Crea recuerdos compartidos',
    text: 'Las anécdotas del juego aparecerán en cada cena de empresa durante años. Garantizado.'
  },
  {
    icon: '',
    title: 'Rompe la rutina',
    text: 'Un equipo que solo trabaja, se quema. Un equipo que también juega, rinde más.'
  }
];

const formatos = [
  {
    title: 'Ginkana de empresa',
    description: 'Pruebas, retos y pistas por equipos recorriendo la ciudad, con puntuación y premio. El formato más completo y el que mejor funciona de primeras.',
    ideal: 'Equipos mixtos, jornadas de empresa, celebraciones',
    href: '/experiencias/ginkana-loca/'
  },
  {
    title: 'Juego de investigación',
    description: 'Un caso, varios sospechosos y pistas repartidas. Obliga a compartir información y a decidir en común, sin correr.',
    ideal: 'Equipos que buscan comunicación y pensar juntos',
    href: '/experiencias/ginkana-cluedo/'
  },
  {
    title: 'Competición por equipos',
    description: 'Pruebas físicas y de estrategia con ranking en vivo. Aquí se compite de verdad, con buen rollo.',
    ideal: 'Equipos comerciales y perfiles competitivos',
    href: '/experiencias/ginkana-supervivientes/'
  },
  {
    title: 'Escape room',
    description: 'Acertijos y tiempo en contra, en local o móvil. El móvil lo llevamos a vuestra oficina, un hotel o una finca.',
    ideal: 'Liderazgo y comunicación bajo presión',
    href: '/escape-room/'
  },
  {
    title: 'Juego a medida',
    description: 'Si nada de lo anterior encaja, diseñamos un juego para vuestro objetivo, vuestro espacio y vuestro tamaño de grupo.',
    ideal: 'Convenciones, aniversarios, eventos especiales',
    href: '/contacto/?tipo=empresa'
  }
];

const galeria = [
  { src: '/images/fotos/galeria-playa.webp', w: 696, h: 464, alt: 'Equipos de empresa en una prueba de equilibrio en la playa' },
  { src: '/images/fotos/galeria-mapa.webp', w: 720, h: 480, alt: 'Equipo consultando un mapa durante una ginkana' },
  { src: '/images/fotos/galeria-investigacion.webp', w: 720, h: 480, alt: 'Grupo investigando pistas en un juego de misterio' },
  { src: '/images/fotos/galeria-cuerda.webp', w: 535, h: 357, alt: 'Equipo tirando de una cuerda en una prueba por equipos' },
];

const ampliado = [
  {
    "h": "Team building a medida: juegos, no solo ginkanas",
    "p": [
      "La ginkana es nuestro formato más conocido, pero para empresas no nos limitamos a ella. Diseñamos <strong>juegos y actividades de team building a medida</strong>, divertidos y adaptados al objetivo, al perfil del equipo y al espacio disponible. Puede ser una ginkana por la ciudad, un juego de investigación, una competición por equipos, un escape room o un juego pensado para vuestro evento.",
      "Todos tienen en común lo esencial: reglas claras, equipos, pruebas y un monitor que dinamiza la actividad. Sin dinámicas forzadas y sin sentarse a escuchar."
    ]
  },
  {
    "h": "Para equipos de todos los tamaños",
    "p": [
      "Trabajamos con grupos de <strong>6 hasta 200 personas</strong> y proponemos el formato según el tamaño y el tiempo disponible (entre 2 y 4 horas):"
    ],
    "ul": [
      "<strong>Equipos pequeños (desde 6 personas):</strong> una ginkana, un juego de investigación o un escape room en local, pensado para grupos reducidos.",
      "<strong>Grupos medianos:</strong> varios equipos que compiten entre sí, con puntuación y ranking en vivo.",
      "<strong>Grupos grandes (hasta 200 personas):</strong> juegos con muchos equipos en paralelo. El escape room móvil admite hasta 100 personas repartidas en equipos y lo llevamos a la oficina, un hotel, una finca o un salón de eventos."
    ]
  },
  {
    "h": "Cómo se prepara una ginkana de empresa",
    "p": [
      "A diferencia de una despedida, una actividad de empresa se prepara a medida. Con el número de personas, la ciudad y el objetivo (integrar a un equipo nuevo, celebrar un cierre de año, mejorar la comunicación), proponemos formato, duración y presupuesto.",
      "El día de la actividad, el punto de encuentro suele ser la plaza del Ayuntamiento o una calle céntrica. El monitor abre con un briefing de 10-15 minutos, divide al grupo en equipos y explica el juego."
    ]
  },
  {
    "h": "Formatos para un equipo de trabajo",
    "ul": [
      "<strong><a href=\"/experiencias/ginkana-cluedo/\">Cluedo</a>:</strong> investigar un caso obliga a compartir información y a decidir en común.",
      "<strong><a href=\"/experiencias/ginkana-supervivientes/\">Supervivientes</a>:</strong> competición por equipos con ranking en vivo; funciona bien con equipos comerciales.",
      "<strong><a href=\"/escape-room/\">Escape room</a>:</strong> comunicación y liderazgo bajo presión, en local o móvil.",
      "<strong><a href=\"/experiencias/ginkana-lendas/\">Lendas</a>:</strong> una actividad con contenido cultural, útil con equipos que vienen de fuera de Galicia."
    ]
  },
  {
    "h": "¿Buscas una jornada completa, una regata o un evento de más de 200 personas?",
    "p": [
      "Ginkanas.es se centra en juegos de equipo de unas horas. Para jornadas de empresa completas, actividades outdoor, experiencias gastronómicas o eventos muy grandes, trabajamos con <a href=\"https://www.mileventosgalicia.com\" rel=\"noopener\">Mil Eventos Galicia</a>, nuestra otra web especializada en eventos de empresa."
    ]
  },
  {
    "h": "Qué cambia en un equipo después",
    "p": [
      "No prometemos milagros de una tarde, pero sí algo que se nota al día siguiente: gente que no se hablaba, hablando; compañeros que descubren cómo piensa otro; y una anécdota compartida para arrancar reuniones. Todo lo demás depende de cómo se use ese impulso después.",
      "Para pedir presupuesto solo hace falta decirnos cuántas personas sois, en qué ciudad y qué fecha tenéis pensada."
    ]
  }
];

const faqs = [
  {
    "q": "¿Solo hacéis ginkanas para empresas?",
    "a": "No. Además de ginkanas, diseñamos juegos y actividades de team building a medida: juegos de investigación, competiciones por equipos y escape room, en local o móvil."
  },
  {
    "q": "¿Para cuántas personas se puede organizar?",
    "a": "Para grupos de 6 hasta 200 personas. El escape room móvil admite hasta 100 personas repartidas en equipos."
  },
  {
    "q": "¿Cuánto dura una actividad de team building?",
    "a": "Entre 2 y 4 horas, según el formato y el objetivo."
  },
  {
    "q": "¿Dónde se puede hacer?",
    "a": "En toda Galicia: por el centro de la ciudad (ginkanas y juegos), en vuestras instalaciones, un hotel, una finca o un salón de eventos (escape room móvil)."
  },
  {
    "q": "¿Cuánto cuesta?",
    "a": "El presupuesto es a medida, según el número de personas, la ciudad y el formato. Pídelo por WhatsApp o desde la página de contacto."
  }
];

const schema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "Team building y juegos para empresas",
  "provider": {
    "@type": "LocalBusiness",
    "name": "Ginkanas.es"
  },
  "areaServed": "Galicia, Spain",
  "description": description
};
---

<Layout title={title} description={description} schema={schema} faqs={faqs} ogImage="/images/fotos/og-empresas.jpg">
  
  <!-- HERO -->
  <section class="hero-inner">
    <div class="container">
      <div class="hero-split">
      <div class="hero-content">
        <span class="hero-badge">Team building que no aburre</span>
        <h1>Team building y <span class="text-gradient">juegos</span> para empresas</h1>
        <p class="hero-text">
          El team building típico es un coñazo. Dinámicas forzadas, silencios incómodos y ganas de volver al curro. 
          Esto es otra cosa: juegos divertidos y team building a medida, para equipos de cualquier tamaño. Aquí se juega, se ríe y se crea equipo de verdad.
        </p>
        <div class="hero-meta">
          <span class="meta-item">En toda Galicia</span>
          <span class="meta-item">De 6 a 200 personas</span>
          <span class="meta-item">2-4 horas de actividad</span>
        </div>
        <div class="hero-cta">
          <a href="https://wa.me/34678288284?text=Hola!%20Necesito%20info%20sobre%20ginkanas%20para%20empresa" class="btn btn-primary btn-lg" target="_blank" rel="noopener">
            Solicitar presupuesto
          </a>
        </div>
      </div>
      <img src="/images/fotos/hero-empresas.webp" width="1000" height="833" alt="Equipo de empresa jugando una ginkana en la playa" class="hero-photo" fetchpriority="high" decoding="async">
      </div>
    </div>
  </section>
  
  <!-- BENEFICIOS -->
  <section class="section">
    <div class="container">
      <div class="section-title">
        <h2>¿Por qué un team building con juegos?</h2>
        <p>Porque las cenas de empresa están bien, pero no crean equipo. Esto sí.</p>
      </div>
      
      <div class="benefits-grid">
        {beneficios.map((b) => (
          <div class="benefit-card">
            <h3>{b.title}</h3>
            <p>{b.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
  
  <!-- FORMATOS -->
  <section class="section section-alt">
    <div class="container">
      <div class="section-title">
        <h2>Formatos que funcionan</h2>
        <p>Cada equipo es diferente. Adaptamos la experiencia a lo que necesitáis.</p>
      </div>
      
      <div class="formats-grid">
        {formatos.map((f) => (
          <div class="format-card">
            <h3>{f.title}</h3>
            <p>{f.description}</p>
            <div class="format-ideal">
              <strong>Ideal para:</strong> {f.ideal}
            </div>
            <a href={f.href} class="format-link">Ver más →</a>
          </div>
        ))}
      </div>
    </div>
  </section>
  
  <!-- GALERÍA -->
  <section class="section">
    <div class="container">
      <div class="section-title">
        <h2>Así se juega</h2>
        <p>Fotos reales de grupos que han jugado con nosotros.</p>
      </div>
      <div class="gallery-grid">
        {galeria.map((g) => (
          <img src={g.src} width={g.w} height={g.h} alt={g.alt} loading="lazy" decoding="async">
        ))}
      </div>
    </div>
  </section>

  <!-- PROCESO -->
  <section class="section">
    <div class="container">
      <div class="section-title">
        <h2>¿Cómo trabajamos con empresas?</h2>
        <p>Sin burocracia. Queremos que sea fácil para ti.</p>
      </div>
      
      <div class="process-timeline">
        <div class="timeline-item">
          <div class="timeline-marker">1</div>
          <div class="timeline-content">
            <h3>Nos cuentas</h3>
            <p>Cuántas personas, qué objetivo buscáis (cohesión, celebración, integración...), fechas posibles y presupuesto orientativo.</p>
          </div>
        </div>
        <div class="timeline-item">
          <div class="timeline-marker">2</div>
          <div class="timeline-content">
            <h3>Proponemos</h3>
            <p>Te mandamos una propuesta personalizada con el formato que mejor encaja, ubicación y precio cerrado.</p>
          </div>
        </div>
        <div class="timeline-item">
          <div class="timeline-marker">3</div>
          <div class="timeline-content">
            <h3>Ajustamos</h3>
            <p>Si quieres cambiar algo, lo adaptamos. Podemos incluir pruebas específicas de vuestra empresa o sector.</p>
          </div>
        </div>
        <div class="timeline-item">
          <div class="timeline-marker">4</div>
          <div class="timeline-content">
            <h3>Ejecutamos</h3>
            <p>El día D nos encargamos de todo. Tú solo tienes que disfrutar con tu equipo.</p>
          </div>
        </div>
      </div>
    </div>
  </section>
  
  <!-- CASOS DE USO -->
  <section class="section section-alt">
    <div class="container">
      <div class="section-title">
        <h2>¿Para qué ocasión?</h2>
        <p>Hay mil excusas para organizar una actividad de empresa. Estas son las más frecuentes.</p>
      </div>
      
      <div class="occasions-grid">
        <div class="occasion">
          <h4>Kick-offs y arranques</h4>
          <p>Empezar el año o un proyecto con energía y buen rollo.</p>
        </div>
        <div class="occasion">
          <h4>Integraciones</h4>
          <p>Cuando se fusionan equipos o llegan muchas incorporaciones.</p>
        </div>
        <div class="occasion">
          <h4>Celebraciones</h4>
          <p>Cerrar un buen trimestre, un aniversario, un logro importante.</p>
        </div>
        <div class="occasion">
          <h4>Cambios de cultura</h4>
          <p>Cuando quieres transmitir que esto es diferente, que aquí se trabaja distinto.</p>
        </div>
        <div class="occasion">
          <h4>Eventos anuales</h4>
          <p>La típica jornada de empresa pero con algo que de verdad mola.</p>
        </div>
        <div class="occasion">
          <h4>Incentivos</h4>
          <p>Premiar al equipo con algo memorable, no con otra cena aburrida.</p>
        </div>
      </div>
    </div>
  </section>
  
  <!-- CTA -->
  <Prose sections={ampliado} />

  <FaqSection faqs={faqs} />

  <section class="section cta-section">
    <div class="container">
      <div class="cta-box">
        <div class="cta-content">
          <h2>¿Hablamos de tu equipo?</h2>
          <p>Cuéntanos qué necesitas y te preparamos una propuesta sin compromiso. Presupuesto cerrado, sin sorpresas.</p>
          <div class="cta-buttons">
            <a href="https://wa.me/34678288284?text=Hola!%20Necesito%20presupuesto%20para%20team%20building" class="btn btn-whatsapp btn-lg" target="_blank" rel="noopener">
              WhatsApp: 678 288 284
            </a>
            <a href="/contacto/" class="btn btn-outline btn-lg">
              Formulario de contacto
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
  
</Layout>

<style>
  .hero-inner {
    background: linear-gradient(135deg, #E8F4FD 0%, var(--color-bg) 100%);
    padding: var(--space-3xl) 0;
  }
  
  .hero-split { display: grid; grid-template-columns: 1.15fr 1fr; gap: var(--space-2xl); align-items: center; }
  .hero-photo { display: block; width: 100%; height: auto; aspect-ratio: 1000 / 833; object-fit: cover; border-radius: var(--radius-lg); box-shadow: var(--shadow-lg); }
  .gallery-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: var(--space-md); }
  .gallery-grid img { width: 100%; height: auto; aspect-ratio: 3 / 2; object-fit: cover; border-radius: var(--radius-md); }
  .format-card { grid-column: span 2; }
  .format-card:nth-child(n+4) { grid-column: span 3; }
  .format-link { display: inline-block; margin-top: var(--space-md); font-weight: 600; }
  .hero-content {
    max-width: 800px;
  }
  
  .hero-badge {
    display: inline-block;
    background: rgba(0, 78, 137, 0.1);
    color: var(--color-secondary);
    padding: var(--space-sm) var(--space-md);
    border-radius: var(--radius-full);
    font-size: 0.875rem;
    font-weight: 600;
    margin-bottom: var(--space-lg);
  }
  
  .text-gradient { color: var(--color-primary); }
  
  .hero-content h1 { margin-bottom: var(--space-md); }
  .hero-text {
    font-size: 1.25rem;
    color: var(--color-text-light);
    margin-bottom: var(--space-xl);
  }
  
  .hero-meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-lg);
    margin-bottom: var(--space-xl);
  }
  
  .meta-item {
    font-weight: 500;
    color: var(--color-text);
  }
  
  .benefits-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-xl);
  }
  
  .benefit-card {
    text-align: center;
    padding: var(--space-xl);
  }
  
  .benefit-icon {
    font-size: 3rem;
    margin-bottom: var(--space-lg);
  }
  
  .benefit-card h3 {
    margin-bottom: var(--space-md);
    font-size: 1.125rem;
  }
  
  .benefit-card p {
    color: var(--color-text-light);
    font-size: 0.9375rem;
  }
  
  .formats-grid {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: var(--space-xl);
  }
  
  .format-card {
    background: var(--color-bg);
    padding: var(--space-xl);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-md);
  }
  
  .format-card h3 {
    color: var(--color-secondary);
    margin-bottom: var(--space-md);
  }
  
  .format-card p {
    color: var(--color-text-light);
    margin-bottom: var(--space-lg);
  }
  
  .format-ideal {
    background: var(--color-bg-alt);
    padding: var(--space-md);
    border-radius: var(--radius-md);
    font-size: 0.875rem;
  }
  
  .process-timeline {
    max-width: 700px;
    margin: 0 auto;
  }
  
  .timeline-item {
    display: flex;
    gap: var(--space-xl);
    padding-bottom: var(--space-xl);
    position: relative;
  }
  
  .timeline-item:not(:last-child)::after {
    content: '';
    position: absolute;
    left: 24px;
    top: 50px;
    bottom: 0;
    width: 2px;
    background: var(--color-border);
  }
  
  .timeline-marker {
    width: 50px;
    height: 50px;
    background: var(--color-secondary);
    color: white;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-display);
    font-weight: 700;
    flex-shrink: 0;
  }
  
  .timeline-content h3 {
    margin-bottom: var(--space-sm);
  }
  
  .timeline-content p {
    color: var(--color-text-light);
  }
  
  .occasions-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-xl);
  }
  
  .occasion {
    background: var(--color-bg);
    padding: var(--space-lg);
    border-radius: var(--radius-md);
  }
  
  .occasion h4 {
    margin-bottom: var(--space-sm);
  }
  
  .occasion p {
    color: var(--color-text-light);
    font-size: 0.9375rem;
    margin: 0;
  }
  
  .cta-section {
    background: var(--color-bg-dark);
  }
  
  .cta-box {
    background: linear-gradient(135deg, var(--color-secondary), #0066B3);
    padding: var(--space-3xl);
    border-radius: var(--radius-lg);
    text-align: center;
  }
  
  .cta-box h2 {
    color: white;
    margin-bottom: var(--space-md);
  }
  
  .cta-box p {
    color: rgba(255,255,255,0.9);
    font-size: 1.125rem;
    margin-bottom: var(--space-xl);
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
  }
  
  .cta-buttons {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: var(--space-md);
  }
  
  .cta-box .btn-outline {
    border-color: white;
    color: white;
  }
  
  .cta-box .btn-outline:hover {
    background: white;
    color: var(--color-secondary);
  }
  
  @media (max-width: 1024px) {
    .hero-split { grid-template-columns: 1fr; }
    .format-card, .format-card:nth-child(n+4) { grid-column: auto; }
    .gallery-grid { grid-template-columns: repeat(2, 1fr); }
    .benefits-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    
    .formats-grid {
      grid-template-columns: 1fr;
    }
    
    .occasions-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  
  @media (max-width: 640px) {
    .benefits-grid {
      grid-template-columns: 1fr;
    }
    
    .occasions-grid {
      grid-template-columns: 1fr;
    }
    
    .timeline-item {
      flex-direction: column;
      gap: var(--space-md);
    }
    
    .timeline-item:not(:last-child)::after {
      display: none;
    }
  }
</style>
