---
// Fila de accesos directos a las páginas de una sección (sustituye a los desplegables del menú).
import Icon from './Icon.astro';

interface Props {
  label: string;
  links: { label: string; href: string; icon?: string }[];
}
const { label, links } = Astro.props;
---

<nav class="quick-links" aria-label={label}>
  <div class="container">
    <ul>
      {links.map((l) => (
        <li><a href={l.href}>{l.icon && <Icon name={l.icon} size={18} />}{l.label}</a></li>
      ))}
    </ul>
  </div>
</nav>

<style>
  .quick-links { background: var(--color-bg); border-bottom: 1px solid var(--color-border); padding: var(--space-md) 0; }
  .quick-links ul { list-style: none; display: flex; flex-wrap: wrap; gap: var(--space-sm); justify-content: center; }
  .quick-links a { display: inline-flex; align-items: center; gap: 6px; padding: 0.45rem 0.9rem; border: 1px solid var(--color-border); border-radius: var(--radius-md); color: var(--color-text); font-size: 0.875rem; font-weight: 600; text-decoration: none; background: var(--color-bg); transition: border-color var(--transition-fast), color var(--transition-fast); }
  .quick-links a:hover { border-color: var(--color-secondary); color: var(--color-secondary); }
  .quick-links :global(.icon) { color: var(--color-secondary); }
</style>
