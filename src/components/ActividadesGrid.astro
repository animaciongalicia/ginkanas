---
// Rejilla de 9 tarjetas: las 6 actividades de team building + escape room, experiencias y juego a medida.
// Se usa en la home y en /ginkanas-empresas/.
import Icon from './Icon.astro';
import { ACTIVIDADES } from '../data/actividades';

const tarjetas = [
  ...ACTIVIDADES.map((a) => ({
    href: `/team-building-${a.slug}/`,
    titulo: a.nombre,
    texto: a.resumen,
    enlace: 'Ver ejemplos →',
    img: a.img,
    mascota: a.mascota,
    icono: a.icono,
  })),
  {
    href: '/escape-room/', titulo: 'Escape room', enlace: 'Ver escape room →', icono: 'key',
    texto: 'En salas temáticas de cada ciudad o móvil en vuestra oficina, hotel o finca.',
    img: { src: '/images/fotos/escape-room-urbano-card.webp', w: 640, h: 480, alt: 'Grupo en una prueba de escape room urbano' },
  },
  {
    href: '/experiencias/', titulo: 'Ginkanas y experiencias', enlace: 'Ver experiencias →', icono: 'map',
    texto: 'Cluedo, Supervivientes, Lendas y el resto de ginkanas, también para equipos de empresa.',
    img: { src: '/images/fotos/ginkana-lendas.webp', w: 1000, h: 750, alt: 'Grupo en la plaza del Obradoiro tras una ginkana' },
  },
  {
    href: '/contacto/?tipo=empresa', titulo: 'Juego a medida', enlace: 'Pedir propuesta →', icono: 'sparkles',
    texto: 'Diseñamos un juego para vuestro objetivo, vuestro espacio y vuestro equipo, con pruebas sobre vuestra empresa.',
    img: { src: '/images/fotos/juego-a-medida.webp', w: 640, h: 480, alt: 'Manos de un equipo sujetando juntas una barra' },
  },
];
---

<div class="act-grid">
  {tarjetas.map((t) => (
    <a href={t.href} class="act-card">
      <div class="act-media">
        {t.img
          ? <img src={t.img.src} alt={t.img.alt} width={t.img.w} height={t.img.h} sizes="(max-width: 640px) calc(100vw - 32px), (max-width: 1024px) calc(50vw - 40px), 380px" loading="lazy" decoding="async">
          : t.mascota
            ? <img src={`/images/mascota/${t.mascota}.webp`} alt="" width="240" height="280" loading="lazy" decoding="async" class="act-mascot">
            : <Icon name={t.icono} size={48} stroke={1.2} />}
      </div>
      <div class="act-body">
        <h3>{t.titulo}</h3>
        <p>{t.texto}</p>
        <span class="act-link">{t.enlace}</span>
      </div>
    </a>
  ))}
</div>

<style>
  .act-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-lg); margin-bottom: var(--space-lg); }
  .act-card { background: var(--color-bg); border: 1px solid var(--color-border); border-radius: var(--radius-lg); overflow: hidden; display: flex; flex-direction: column; color: var(--color-text); text-decoration: none; transition: box-shadow var(--transition-normal), border-color var(--transition-normal); }
  .act-card:hover { box-shadow: var(--shadow-md); border-color: var(--color-secondary); color: var(--color-text); }
  .act-media { height: 175px; display: flex; align-items: center; justify-content: center; background: var(--color-bg-alt); color: var(--color-secondary); overflow: hidden; }
  .act-media img { flex: 0 0 100%; width: 100%; height: 100%; object-fit: cover; }
  .act-media img.act-mascot { flex: 0 0 auto; width: auto; height: 155px; object-fit: contain; }
  .act-body { padding: var(--space-lg); display: flex; flex-direction: column; gap: var(--space-sm); flex-grow: 1; }
  .act-body h3 { margin: 0; }
  .act-body p { color: var(--color-text-light); font-size: 0.9375rem; margin: 0; flex-grow: 1; }
  .act-link { color: var(--color-primary); font-weight: 600; font-size: 0.875rem; }
  @media (max-width: 1024px) { .act-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 640px) { .act-grid { grid-template-columns: minmax(0, 1fr); } }
</style>
