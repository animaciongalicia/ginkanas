---
// Bloque de texto editorial: título + párrafos + lista (numerada o no). Se usa para el contenido largo de las páginas.
interface Section { h: string; p?: string[]; ol?: string[]; ul?: string[]; after?: string[] }
interface Props { sections: Section[]; alt?: boolean }
const { sections, alt = false } = Astro.props;
---

<section class={`section prose-block${alt ? ' section-alt' : ''}`}>
  <div class="container">
    <div class="prose-inner">
      {sections.map((s) => (
        <div class="prose-part">
          <h2>{s.h}</h2>
          {s.p?.map((t) => <p set:html={t} />)}
          {s.ol && <ol>{s.ol.map((t) => <li set:html={t} />)}</ol>}
          {s.ul && <ul>{s.ul.map((t) => <li set:html={t} />)}</ul>}
          {s.after?.map((t) => <p set:html={t} />)}
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .prose-inner { max-width: 820px; margin: 0 auto; }
  .prose-part + .prose-part { margin-top: var(--space-2xl); padding-top: var(--space-xl); border-top: 1px solid var(--color-border); }
  .prose-part h2 { font-size: clamp(1.4rem, 3vw, 1.9rem); margin-bottom: var(--space-md); }
  .prose-part p { color: var(--color-text-light); line-height: 1.7; }
  .prose-part ul, .prose-part ol { margin: var(--space-md) 0 var(--space-lg); padding-left: var(--space-xl); }
  .prose-part li { color: var(--color-text-light); line-height: 1.65; margin-bottom: var(--space-sm); }
  .prose-part li strong, .prose-part p strong { color: var(--color-text); }
</style>
