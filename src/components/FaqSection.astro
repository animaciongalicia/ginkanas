---
// Preguntas frecuentes visibles (acordeón <details>, rastreable). El Layout emite el FAQPage JSON-LD con los mismos datos.
interface Props {
  faqs: { q: string; a: string }[];
  heading?: string;
}
const { faqs, heading = 'Preguntas frecuentes' } = Astro.props;
---

<section class="section faq-block">
  <div class="container">
    <h2>{heading}</h2>
    <div class="faq-list">
      {faqs.map((f) => (
        <details class="faq-entry">
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .faq-block h2 { text-align: center; margin-bottom: var(--space-xl); }
  .faq-list { max-width: 820px; margin: 0 auto; display: grid; gap: var(--space-md); }
  .faq-entry { background: var(--color-bg-alt); border-radius: var(--radius-md); padding: var(--space-md) var(--space-lg); }
  .faq-entry summary { cursor: pointer; font-weight: 600; list-style: none; display: flex; justify-content: space-between; gap: var(--space-md); }
  .faq-entry summary::-webkit-details-marker { display: none; }
  .faq-entry summary::after { content: '+'; color: var(--color-primary); font-size: 1.25rem; line-height: 1; }
  .faq-entry[open] summary::after { content: '\2212'; }
  .faq-entry p { margin: var(--space-md) 0 0; color: var(--color-text-light); }
</style>
