---
import interFontUrl from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppFloat from '../components/WhatsAppFloat.astro';
import CookieConsent from '../components/CookieConsent.astro';
import { GSC_VERIFICATION } from '../config/tracking';
import { SITE, ORG_ID, WEBSITE_ID, organizationSchema, normalizeSchema, breadcrumbSchema, faqSchema } from '../lib/seo';

interface FaqItem { q?: string; a?: string; question?: string; answer?: string }

interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  schema?: object | object[];
  faqs?: FaqItem[];
  noindex?: boolean;
  breadcrumbName?: string;
  publishedTime?: string;
  modifiedTime?: string;
}

const {
  title,
  description,
  canonical: canonicalProp,
  ogImage = '/images/og-default.png',
  schema,
  faqs,
  noindex = false,
  breadcrumbName,
  publishedTime,
  modifiedTime,
} = Astro.props;

const siteName = 'Ginkanas.es';
const withBrand = `${title} | ${siteName}`;
const fullTitle = title.includes(siteName) || withBrand.length > 62 ? title : withBrand;

const pathname = Astro.url.pathname;
const canonical = canonicalProp ?? new URL(pathname, SITE).href;
const ogImageUrl = new URL(ogImage, SITE).href;
const isArticle = /^\/blog\/[^/]+\/?$/.test(pathname);
const pageId = `${canonical}#webpage`;

const graph: object[] = [
  organizationSchema,
  {
    '@type': 'WebSite',
    '@id': WEBSITE_ID,
    url: `${SITE}/`,
    name: siteName,
    inLanguage: 'es-ES',
    publisher: { '@id': ORG_ID },
  },
  {
    '@type': 'WebPage',
    '@id': pageId,
    url: canonical,
    name: fullTitle,
    description,
    inLanguage: 'es-ES',
    isPartOf: { '@id': WEBSITE_ID },
    about: { '@id': ORG_ID },
    primaryImageOfPage: { '@type': 'ImageObject', url: ogImageUrl },
    breadcrumb: { '@id': `${canonical}#breadcrumb` },
  },
];

const crumbs = breadcrumbSchema(pathname, canonical, breadcrumbName ?? title);
if (crumbs) graph.push(crumbs);

const pageSchemas = schema ? (Array.isArray(schema) ? schema : [schema]) : [];
for (const s of pageSchemas) graph.push(normalizeSchema(s, canonical, ogImageUrl));

if (faqs?.length) {
  const faq = faqSchema(faqs, canonical);
  if (faq) graph.push(faq);
}

const jsonLd = JSON.stringify({ '@context': 'https://schema.org', '@graph': graph });
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#0B3A6F">
  {GSC_VERIFICATION && <meta name="google-site-verification" content={GSC_VERIFICATION}>}

  <!-- Fuentes críticas precargadas (evita saltos de diseño) -->
  <link rel="preload" href={interFontUrl} as="font" type="font/woff2" crossorigin>

  <!-- SEO básico -->
  <title>{fullTitle}</title>
  <meta name="description" content={description}>
  <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'}>
  <link rel="canonical" href={canonical}>
  <link rel="sitemap" type="application/xml" href="/sitemap-index.xml">
  <link rel="alternate" type="application/rss+xml" title="Blog de Ginkanas.es" href="/rss.xml">
  <link rel="alternate" type="text/plain" href="/llms.txt" title="Resumen del sitio para modelos de lenguaje (llms.txt)">

  <!-- Open Graph -->
  <meta property="og:type" content={isArticle ? 'article' : 'website'}>
  <meta property="og:url" content={canonical}>
  <meta property="og:title" content={fullTitle}>
  <meta property="og:description" content={description}>
  <meta property="og:image" content={ogImageUrl}>
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content="Ginkanas.es: ginkanas y experiencias para grupos en Galicia">
  <meta property="og:site_name" content={siteName}>
  <meta property="og:locale" content="es_ES">
  {isArticle && publishedTime && <meta property="article:published_time" content={publishedTime}>}
  {isArticle && modifiedTime && <meta property="article:modified_time" content={modifiedTime}>}

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content={fullTitle}>
  <meta name="twitter:description" content={description}>
  <meta name="twitter:image" content={ogImageUrl}>

  <!-- Iconos -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">

  <!-- Datos estructurados (Organization, WebSite, WebPage, BreadcrumbList, Service/Article, FAQPage) -->
  <script type="application/ld+json" set:html={jsonLd} />
</head>
<body>
  <a href="#contenido" class="sr-only">Saltar al contenido</a>
  <Header />

  <main id="contenido">
    <slot />
  </main>

  <Footer />
  <WhatsAppFloat />
  <CookieConsent />
</body>
</html>
