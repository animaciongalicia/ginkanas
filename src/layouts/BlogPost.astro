---
import Layout from './Layout.astro';
import Icon from '../components/Icon.astro';
import { TEMAS, formatDate, isoDate, readingTime, type BlogEntry } from '../lib/blog';

interface Props {
  post: BlogEntry;
  headings?: { depth: number; slug: string; text: string }[];
  relacionados?: BlogEntry[];
}
const { post, headings = [], relacionados = [] } = Astro.props;
const d = post.data;
const tema = TEMAS[d.tema];
const url = `/blog/${post.slug}/`;
const fullUrl = new URL(url, 'https://www.ginkanas.es').href;
const modificado = d.actualizado ?? d.fecha;
const minutos = readingTime(post.body);
const indice = headings.filter((h) => h.depth === 2);

const schema = {
  '@type': 'BlogPosting',
  headline: d.titulo,
  description: d.descripcion,
  datePublished: isoDate(d.fecha),
  dateModified: isoDate(modificado),
  ...(d.autor ? { author: { '@type': 'Person', name: d.autor } } : {}),
};

const esEmpresa = d.tema === 'empresas';
const cta = d.cta ?? { titulo: '¿Quieres que te ayudemos?', texto: 'Cuéntanos qué tenéis en mente y os recomendamos la actividad que mejor encaja.' };
const faqs = d.faqs.map((f) => ({ q: f.pregunta, a: f.respuesta }));
const wa = `https://wa.me/34678288284?text=${encodeURIComponent(`Hola! He leído "${d.titulo}" y quiero información.`)}`;
const formulario = esEmpresa ? '/contacto/?tipo=empresa' : '/contacto/';

// Páginas de servicio según el tema del artículo
const servicios: Record<string, { label: string; href: string }[]> = {
  empresas: [
    { label: 'Team building para empresas', href: '/ginkanas-empresas/' },
    { label: 'Ginkanas y juegos de retos', href: '/team-building-ginkanas-y-retos/' },
    { label: 'Escape room', href: '/escape-room/' },
  ],
  juegos: [
    { label: 'Actividades para empresas', href: '/ginkanas-empresas/' },
    { label: 'Ginkanas para grupos', href: '/ginkanas-adultos/' },
    { label: 'Todas las experiencias', href: '/experiencias/' },
  ],
  despedidas: [
    { label: 'Despedida de soltera', href: '/ginkanas-despedidas/soltera/' },
    { label: 'Despedida de soltero', href: '/ginkanas-despedidas/soltero/' },
    { label: 'Todas las despedidas', href: '/ginkanas-despedidas/' },
  ],
  cumpleanos: [
    { label: 'Ginkanas para grupos', href: '/ginkanas-adultos/' },
    { label: 'Todas las experiencias', href: '/experiencias/' },
  ],
  general: [
    { label: 'Todas las experiencias', href: '/experiencias/' },
    { label: 'Actividades para empresas', href: '/ginkanas-empresas/' },
    { label: 'Ginkanas para grupos', href: '/ginkanas-adultos/' },
  ],
};
const enlacesTema = servicios[d.tema] ?? servicios.general;
---

<Layout
  title={d.titulo}
  description={d.descripcion}
  schema={schema}
  faqs={faqs}
  publishedTime={isoDate(d.fecha)}
  modifiedTime={isoDate(modificado)}
>
  <div class="read-progress" aria-hidden="true"><span id="read-progress-bar"></span></div>

  <article class="blog-post" style={`--tema-accent: ${tema.accent}; --tema-bg: ${tema.bg}`}>
    <header class="post-header">
      <div class="container">
        <nav class="crumbs" aria-label="Ruta">
          <a href="/">Inicio</a><span aria-hidden="true">›</span><a href="/blog/">Blog</a><span aria-hidden="true">›</span><span>{tema.label}</span>
        </nav>
        <span class="post-category"><Icon name={tema.icon} size={14} />{d.etiqueta ?? (d.tipo === 'novedad' ? 'Novedad' : tema.label)}</span>
        <h1>{d.titulo}</h1>
        <p class="post-intro">{d.intro}</p>
        <p class="post-meta">
          <span><Icon name="clock" size={16} /> {minutos} min de lectura</span>
          <span><time datetime={isoDate(d.fecha)}>{formatDate(d.fecha)}</time></span>
          {d.actualizado && d.actualizado.valueOf() !== d.fecha.valueOf() && (
            <span>Actualizado el <time datetime={isoDate(d.actualizado)}>{formatDate(d.actualizado)}</time></span>
          )}
          <span>{d.autor ? `Por ${d.autor}` : 'Equipo Ginkanas.es'}</span>
        </p>
      </div>
    </header>

    <div class="container post-layout">
      <div class="post-main">
        {indice.length > 2 && (
          <details class="toc-mobile">
            <summary>En este artículo</summary>
            <ol>{indice.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol>
          </details>
        )}

        <div class="post-content">
          <slot />
        </div>

        {d.faqs.length > 0 && (
          <section class="post-faqs" aria-labelledby="faq-h">
            <h2 id="faq-h">Preguntas frecuentes</h2>
            {d.faqs.map((f) => (
              <details>
                <summary>{f.pregunta}</summary>
                <p>{f.respuesta}</p>
              </details>
            ))}
          </section>
        )}

        <div class="post-cta">
          <img src="/images/mascota/ok.webp" alt="" width="244" height="400" loading="lazy" decoding="async" class="post-cta-mascot">
          <div>
            <h2>{cta.titulo}</h2>
            <p>{cta.texto}</p>
            <div class="post-cta-actions">
              <a href={wa} class="btn btn-whatsapp" target="_blank" rel="noopener">Escríbenos por WhatsApp</a>
              <a href={formulario} class="btn btn-outline">Pedir propuesta</a>
            </div>
          </div>
        </div>

        <div class="post-share">
          <span>Compartir:</span>
          <a href={`https://wa.me/?text=${encodeURIComponent(d.titulo + ' ' + fullUrl)}`} target="_blank" rel="noopener">WhatsApp</a>
          <a href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(fullUrl)}`} target="_blank" rel="noopener">LinkedIn</a>
          <button type="button" class="copy-link" data-url={fullUrl}>Copiar enlace</button>
        </div>
      </div>

      <aside class="post-aside">
        {indice.length > 2 && (
          <nav class="aside-box toc" aria-label="Índice del artículo">
            <h2>En este artículo</h2>
            <ol>{indice.map((h) => <li><a href={`#${h.slug}`} data-toc={h.slug}>{h.text}</a></li>)}</ol>
          </nav>
        )}
        <div class="aside-box aside-cta">
          <h2>¿Lo organizamos?</h2>
          <p>De 6 a 200 personas, en toda Galicia, con monitor.</p>
          <a href={wa} class="btn btn-whatsapp" target="_blank" rel="noopener">WhatsApp</a>
          <a href={formulario} class="aside-link">o pide propuesta →</a>
        </div>
        <div class="aside-box">
          <h2>Te puede interesar</h2>
          <ul class="aside-links">
            {[...d.relacionados.map((r) => ({ label: r.titulo, href: r.enlace })), ...enlacesTema]
              .filter((l, i, arr) => arr.findIndex((x) => x.href === l.href) === i)
              .slice(0, 4)
              .map((l) => <li><a href={l.href}>{l.label}</a></li>)}
          </ul>
        </div>
      </aside>
    </div>

    {relacionados.length > 0 && (
      <section class="section section-alt post-related">
        <div class="container">
          <div class="related-head">
            <h2>Sigue leyendo</h2>
            <a href="/blog/">Ver todo el blog →</a>
          </div>
          <div class="related-grid">
            {relacionados.map((p) => (
              <a href={`/blog/${p.slug}/`} class="related-card" style={`--c: ${TEMAS[p.data.tema].accent}; --b: ${TEMAS[p.data.tema].bg}`}>
                <span class="related-art"><Icon name={TEMAS[p.data.tema].icon} size={26} /><em>{p.data.etiqueta ?? TEMAS[p.data.tema].label}</em></span>
                <strong>{p.data.titulo}</strong>
                <span class="related-meta">{readingTime(p.body)} min de lectura</span>
              </a>
            ))}
          </div>
        </div>
      </section>
    )}
  </article>
  <script is:inline>
(() => {
// Barra de progreso de lectura
  const bar = document.getElementById('read-progress-bar');
  const article = document.querySelector('.post-main');
  const update = () => {
    if (!bar || !article) return;
    const r = article.getBoundingClientRect();
    const total = r.height - window.innerHeight;
    const p = total > 0 ? Math.min(1, Math.max(0, -r.top / total)) : 1;
    bar.style.transform = `scaleX(${p})`;
  };
  window.addEventListener('scroll', update, { passive: true });
  update();

  // Índice: marca la sección visible
  const links = Array.from(document.querySelectorAll('a[data-toc]'));
  if (links.length && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver((entries) => {
      entries.forEach((e) => {
        if (e.isIntersecting) links.forEach((l) => l.classList.toggle('active', l.dataset.toc === e.target.id));
      });
    }, { rootMargin: '-20% 0px -70% 0px' });
    links.forEach((l) => { const h = document.getElementById(l.dataset.toc); if (h) io.observe(h); });
  }

  // Copiar enlace
  const copy = document.querySelector('.copy-link');
  copy && copy.addEventListener('click', async () => {
    try { await navigator.clipboard.writeText(copy.dataset.url); copy.textContent = 'Enlace copiado'; } catch { copy.textContent = copy.dataset.url; }
  });
})();
</script>
</Layout>


<style is:global>
  .read-progress { position: fixed; top: 0; left: 0; right: 0; height: 3px; z-index: 200; pointer-events: none; }
  .read-progress span { display: block; height: 100%; background: var(--color-primary); transform-origin: 0 50%; transform: scaleX(0); }

  .blog-post .post-header { background: var(--color-bg-alt); padding: var(--space-xl) 0 var(--space-2xl); border-bottom: 1px solid var(--color-border); }
  .blog-post .crumbs { display: flex; flex-wrap: wrap; gap: 6px; font-size: 0.8125rem; color: var(--color-text-light); margin-bottom: var(--space-lg); }
  .blog-post .crumbs a { color: var(--color-text-light); }
  .blog-post .crumbs a:hover { color: var(--color-primary); }
  .blog-post .post-category { display: inline-flex; align-items: center; gap: 6px; background: var(--tema-accent); color: #fff; padding: 4px 10px; border-radius: var(--radius-full); font-size: 0.75rem; font-weight: 600; margin-bottom: var(--space-md); }
  .blog-post .post-header h1 { margin-bottom: var(--space-md); max-width: 820px; }
  .blog-post .post-intro { font-size: 1.125rem; color: var(--color-text-light); max-width: 720px; margin-bottom: var(--space-lg); }
  .blog-post .post-meta { display: flex; flex-wrap: wrap; gap: var(--space-sm) var(--space-lg); color: var(--color-text-light); font-size: 0.875rem; margin: 0; }
  .blog-post .post-meta span { display: inline-flex; align-items: center; gap: 6px; }

  .post-layout { display: grid; grid-template-columns: minmax(0, 1fr) 280px; gap: var(--space-3xl); padding-top: var(--space-2xl); padding-bottom: var(--space-3xl); align-items: start; }
  .post-main { max-width: 740px; min-width: 0; }

  .blog-post .post-content { font-size: 1.0625rem; }
  .blog-post .post-content h2 { font-size: 1.5rem; margin: var(--space-2xl) 0 var(--space-md); scroll-margin-top: 90px; }
  .blog-post .post-content > h2:first-child { margin-top: 0; }
  .blog-post .post-content h3 { font-size: 1.1875rem; margin: var(--space-xl) 0 var(--space-sm); scroll-margin-top: 90px; }
  .blog-post .post-content p { color: var(--color-text); margin-bottom: var(--space-md); line-height: 1.75; }
  .blog-post .post-content ul, .blog-post .post-content ol { margin: var(--space-md) 0 var(--space-lg); padding-left: 1.3em; }
  .blog-post .post-content li { margin-bottom: var(--space-sm); line-height: 1.7; }
  .blog-post .post-content li::marker { color: var(--tema-accent); }
  .blog-post .post-content a { color: var(--color-primary); font-weight: 500; text-decoration: underline; text-underline-offset: 3px; text-decoration-thickness: 1px; }
  .blog-post .post-content strong { color: var(--color-text); }
  .blog-post .post-content blockquote { border-left: 3px solid var(--tema-accent); background: var(--color-bg-alt); padding: var(--space-md) var(--space-lg); margin: var(--space-lg) 0; border-radius: 0 var(--radius-md) var(--radius-md) 0; }
  .blog-post .post-content blockquote p:last-child { margin: 0; }
  .blog-post .post-content .btn { color: var(--color-text-inverse); text-decoration: none; }

  .blog-post .post-content table { width: 100%; border-collapse: collapse; margin: var(--space-lg) 0 var(--space-xl); font-size: 0.9375rem; }
  .blog-post .post-content th, .blog-post .post-content td { padding: var(--space-sm) var(--space-md); text-align: left; border-bottom: 1px solid var(--color-border); }
  .blog-post .post-content th { background: var(--color-bg-alt); font-weight: 600; }
  .blog-post .post-content table.price-table tr.total { background: var(--color-primary); color: white; }
  .blog-post .post-content table.price-table tr.total strong { color: white; }
  @media (max-width: 640px) { .blog-post .post-content table { display: block; overflow-x: auto; } }

  .toc-mobile { display: none; background: var(--color-bg-alt); border-radius: var(--radius-md); padding: var(--space-md) var(--space-lg); margin-bottom: var(--space-xl); }
  .toc-mobile summary { cursor: pointer; font-weight: 600; }
  .toc-mobile ol { margin: var(--space-sm) 0 0; padding-left: 1.2em; }
  .toc-mobile li { margin: 6px 0; }

  .post-faqs { margin-top: var(--space-2xl); }
  .post-faqs h2 { font-size: 1.5rem; margin-bottom: var(--space-md); }
  .post-faqs details { border: 1px solid var(--color-border); border-radius: var(--radius-md); padding: var(--space-md) var(--space-lg); margin-bottom: var(--space-sm); background: var(--color-bg); }
  .post-faqs summary { cursor: pointer; font-weight: 600; }
  .post-faqs details[open] summary { color: var(--color-primary); }
  .post-faqs details p { margin: var(--space-sm) 0 0; color: var(--color-text-light); }

  .post-cta { display: flex; gap: var(--space-lg); align-items: center; background: var(--color-bg-dark); color: #fff; border-radius: var(--radius-lg); padding: var(--space-xl); margin: var(--space-2xl) 0 var(--space-lg); }
  .post-cta h2 { color: #fff; font-size: 1.375rem; margin: 0 0 var(--space-sm); }
  .post-cta p { color: rgba(255, 255, 255, 0.85); margin: 0 0 var(--space-lg); }
  .post-cta-mascot { height: 150px; width: auto; flex-shrink: 0; }
  .post-cta-actions { display: flex; flex-wrap: wrap; gap: var(--space-sm); }
  .post-cta .btn-outline { border-color: #fff; color: #fff; }
  .post-cta .btn-outline:hover { background: #fff; color: var(--color-bg-dark); }

  .post-share { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-sm); font-size: 0.875rem; color: var(--color-text-light); }
  .post-share a, .post-share button { border: 1px solid var(--color-border); border-radius: var(--radius-md); padding: 6px 12px; color: var(--color-text); background: var(--color-bg); font: inherit; font-weight: 600; cursor: pointer; text-decoration: none; }
  .post-share a:hover, .post-share button:hover { border-color: var(--color-secondary); color: var(--color-secondary); }

  .post-aside { position: sticky; top: 90px; display: flex; flex-direction: column; gap: var(--space-md); }
  .aside-box { border: 1px solid var(--color-border); border-radius: var(--radius-lg); padding: var(--space-lg); background: var(--color-bg); }
  .aside-box h2 { font-size: 0.8125rem; text-transform: uppercase; letter-spacing: 0.06em; color: var(--color-text-light); margin: 0 0 var(--space-sm); }
  .toc ol { list-style: none; margin: 0; padding: 0; display: grid; gap: 2px; }
  .toc a { display: block; padding: 5px 0 5px 10px; border-left: 2px solid var(--color-border); color: var(--color-text-light); font-size: 0.875rem; line-height: 1.4; }
  .toc a:hover, .toc a.active { color: var(--color-primary); border-left-color: var(--color-primary); }
  .aside-cta { background: var(--color-bg-alt); border-color: transparent; }
  .aside-cta h2 { color: var(--color-text); font-size: 1rem; text-transform: none; letter-spacing: 0; }
  .aside-cta p { font-size: 0.875rem; color: var(--color-text-light); margin-bottom: var(--space-md); }
  .aside-cta .btn { width: 100%; }
  .aside-link { display: block; text-align: center; margin-top: var(--space-sm); font-size: 0.875rem; font-weight: 600; }
  .aside-links { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--space-sm); }
  .aside-links a { font-size: 0.9375rem; font-weight: 500; }

  .related-head { display: flex; justify-content: space-between; align-items: baseline; gap: var(--space-md); margin-bottom: var(--space-lg); }
  .related-head h2 { margin: 0; }
  .related-head a { font-weight: 600; }
  .related-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-lg); }
  .related-card { display: flex; flex-direction: column; gap: var(--space-sm); background: var(--color-bg); border: 1px solid var(--color-border); border-radius: var(--radius-lg); overflow: hidden; color: var(--color-text); text-decoration: none; padding-bottom: var(--space-lg); }
  .related-card:hover { border-color: var(--c); box-shadow: var(--shadow-md); color: var(--color-text); }
  .related-art { display: flex; justify-content: space-between; align-items: center; background: var(--b); color: var(--c); padding: var(--space-md) var(--space-lg); }
  .related-art em { font-style: normal; font-size: 0.75rem; font-weight: 700; }
  .related-card strong { padding: 0 var(--space-lg); font-size: 1.0625rem; line-height: 1.35; }
  .related-meta { padding: 0 var(--space-lg); font-size: 0.8125rem; color: var(--color-text-light); margin-top: auto; }

  @media (max-width: 1024px) {
    .post-layout { grid-template-columns: minmax(0, 1fr); gap: var(--space-xl); }
    .post-main { max-width: none; }
    .post-aside { position: static; }
    .post-aside .toc { display: none; }
    .toc-mobile { display: block; }
    .related-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 640px) {
    .post-cta { flex-direction: column; text-align: center; }
    .post-cta-actions { justify-content: center; }
    .post-cta-mascot { height: 120px; }
    .related-grid { grid-template-columns: minmax(0, 1fr); }
    .related-head { flex-direction: column; }
  }
</style>
