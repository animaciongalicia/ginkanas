---
import Layout from './Layout.astro';
import { TEMAS, formatDate, isoDate, type BlogEntry } from '../lib/blog';

interface Props { post: BlogEntry }
const { post } = Astro.props;
const d = post.data;
const tema = TEMAS[d.tema];
const url = `/blog/${post.slug}/`;
const modificado = d.actualizado ?? d.fecha;

const schema = {
  '@type': 'BlogPosting',
  headline: d.titulo,
  description: d.descripcion,
  datePublished: isoDate(d.fecha),
  dateModified: isoDate(modificado),
  ...(d.autor ? { author: { '@type': 'Person', name: d.autor } } : {}),
};

const cta = d.cta ?? { titulo: '¿Quieres que te ayudemos?', texto: 'Cuéntanos qué tenéis en mente y os recomendamos la ginkana que mejor encaja.' };
const faqs = d.faqs.map((f) => ({ q: f.pregunta, a: f.respuesta }));
---

<Layout
  title={d.titulo}
  description={d.descripcion}
  schema={schema}
  faqs={faqs}
  publishedTime={isoDate(d.fecha)}
  modifiedTime={isoDate(modificado)}
>
  <article class="blog-post" style={`--tema-accent: ${tema.accent}; --tema-bg: ${tema.bg}`}>
    <header class="post-header">
      <div class="container">
        <span class="post-category">{d.etiqueta ?? (d.tipo === 'novedad' ? 'Novedad' : tema.label)}</span>
        <h1>{d.titulo}</h1>
        <p class="post-intro">{d.intro}</p>
        <p class="post-dates">
          <time datetime={isoDate(d.fecha)}>{formatDate(d.fecha)}</time>
          {d.actualizado && d.actualizado.valueOf() !== d.fecha.valueOf() && (
            <span> · Actualizado el <time datetime={isoDate(d.actualizado)}>{formatDate(d.actualizado)}</time></span>
          )}
          {d.autor && <span> · Por {d.autor}</span>}
        </p>
      </div>
    </header>

    <div class="container">
      <div class="post-content">
        <slot />

        {d.faqs.length > 0 && (
          <section class="post-faqs">
            <h2>Preguntas frecuentes</h2>
            {d.faqs.map((f) => (
              <details>
                <summary>{f.pregunta}</summary>
                <p>{f.respuesta}</p>
              </details>
            ))}
          </section>
        )}

        <div class="cta-box">
          <h3>{cta.titulo}</h3>
          <p>{cta.texto}</p>
          <a href="https://wa.me/34678288284" class="btn btn-whatsapp">WhatsApp: 678 288 284</a>
        </div>

        {d.relacionados.length > 0 && (
          <>
            <h2>Artículos relacionados</h2>
            <ul>
              {d.relacionados.map((r) => <li><a href={r.enlace}>{r.titulo}</a></li>)}
            </ul>
          </>
        )}
      </div>
    </div>
  </article>
</Layout>

<style is:global>
  .blog-post .post-header {
    background: linear-gradient(135deg, var(--tema-bg) 0%, #fff 100%);
    padding: var(--space-3xl) 0 var(--space-2xl);
  }
  .blog-post .post-category {
    display: inline-block;
    background: var(--tema-accent);
    color: white;
    padding: var(--space-xs) var(--space-md);
    border-radius: var(--radius-full);
    font-size: 0.75rem;
    font-weight: 600;
    margin-bottom: var(--space-md);
  }
  .blog-post .post-header h1 { margin-bottom: var(--space-lg); max-width: 800px; }
  .blog-post .post-intro { font-size: 1.25rem; color: var(--color-text-light); max-width: 700px; margin-bottom: var(--space-lg); }
  .blog-post .post-dates { color: var(--color-text-light); font-size: 0.875rem; margin: 0; }

  .blog-post .post-content { max-width: 800px; margin: 0 auto; padding: var(--space-2xl) 0 var(--space-3xl); }
  .blog-post .post-content h2 {
    margin-top: var(--space-2xl);
    margin-bottom: var(--space-lg);
    padding-top: var(--space-lg);
    border-top: 1px solid var(--color-border);
  }
  .blog-post .post-content > h2:first-child { margin-top: 0; padding-top: 0; border-top: none; }
  .blog-post .post-content h3 { margin-top: var(--space-xl); margin-bottom: var(--space-md); color: var(--tema-accent); }
  .blog-post .post-content p { color: var(--color-text-light); margin-bottom: var(--space-md); line-height: 1.7; }
  .blog-post .post-content ul,
  .blog-post .post-content ol { margin: var(--space-md) 0 var(--space-lg); padding-left: var(--space-xl); }
  .blog-post .post-content li { margin-bottom: var(--space-sm); color: var(--color-text-light); }
  .blog-post .post-content a { color: var(--color-primary); font-weight: 500; }
  .blog-post .post-content .btn { color: var(--color-text-inverse); }

  .blog-post .post-content table { width: 100%; border-collapse: collapse; margin: var(--space-lg) 0 var(--space-xl); }
  .blog-post .post-content th,
  .blog-post .post-content td { padding: var(--space-md); text-align: left; border-bottom: 1px solid var(--color-border); }
  .blog-post .post-content th { background: var(--color-bg-alt); font-weight: 600; }
  .blog-post .post-content table.comparison-table tr:hover td { background: var(--color-bg-alt); }
  .blog-post .post-content table.price-table tr.total { background: var(--color-primary); color: white; }
  .blog-post .post-content table.price-table tr.total td { border-bottom: none; }
  @media (max-width: 640px) { .blog-post .post-content table { display: block; overflow-x: auto; } }

  .blog-post .post-faqs details { background: var(--color-bg-alt); border-radius: var(--radius-md); padding: var(--space-md) var(--space-lg); margin-bottom: var(--space-md); }
  .blog-post .post-faqs summary { cursor: pointer; font-weight: 600; }
  .blog-post .post-faqs details p { margin: var(--space-md) 0 0; }

  .blog-post .cta-box { background: var(--color-bg-alt); padding: var(--space-xl); border-radius: var(--radius-lg); margin: var(--space-2xl) 0; text-align: center; }
  .blog-post .cta-box h3 { margin: 0 0 var(--space-md); color: var(--color-text); }
  .blog-post .cta-box p { margin-bottom: var(--space-lg); }
</style>
